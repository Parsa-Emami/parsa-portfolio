APP_NAME="Parsa Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portfolio.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_VERSION=1.0.0
APP_COMMIT_SHA=
APP_BUILD_NUMBER=

FORCE_HTTPS=true
CSP_MODE=enforce
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
HEALTH_EXPOSE_DETAILS=false
SLOW_QUERY_MS=750
ACTIVITY_RETENTION_DAYS=180

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parsa_portfolio
DB_USERNAME=parsa_portfolio
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# BACKUP_PATH=/absolute/path/outside/web-root
BACKUP_KEEP=14
BACKUP_TIME=02:15
MYSQLDUMP_BINARY=mysqldump
PG_DUMP_BINARY=pg_dump

PORTFOLIO_NAME="Parsa Emami"
PORTFOLIO_EMAIL=
PORTFOLIO_LOCATION="Tehran · Remote"
PORTFOLIO_GITHUB_URL=https://github.com/Parsa-Emami

ADMIN_NAME="Parsa Emami"
ADMIN_EMAIL=
ADMIN_PASSWORD=
