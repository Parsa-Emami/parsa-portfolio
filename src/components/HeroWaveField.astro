---
const { class: className } = Astro.props
---

<div class:list={['hero-wave', className]} data-hero-wave aria-hidden="true">
  <canvas class="hero-wave__canvas"></canvas>
  <div class="hero-wave__focus"></div>
  <div class="hero-wave__vignette"></div>
</div>

<script>
  import { HeroWaveEngine } from '../utils/HeroWaveEngine'

  type WaveHost = HTMLElement & { __heroWaveEngine?: HeroWaveEngine }
  type LifecycleDocument = Document & { __heroWaveLifecycleBound?: boolean }

  const getHosts = () => document.querySelectorAll<WaveHost>('[data-hero-wave]')

  const mountHeroWaves = () => {
    getHosts().forEach((host) => {
      if (host.__heroWaveEngine) return

      try {
        host.__heroWaveEngine = new HeroWaveEngine(host)
        host.dataset.waveMounted = 'true'
      } catch (error) {
        host.classList.add('is-fallback')
        host.dataset.waveMounted = 'fallback'
        host.dataset.waveStatus = 'fallback'
        console.warn('[hero-wave] Canvas engine unavailable; using CSS fallback.', error)
      }
    })
  }

  const destroyHeroWaves = () => {
    getHosts().forEach((host) => {
      host.__heroWaveEngine?.destroy()
      delete host.__heroWaveEngine
      delete host.dataset.waveMounted
    })
  }

  const lifecycleDocument = document as LifecycleDocument
  if (!lifecycleDocument.__heroWaveLifecycleBound) {
    lifecycleDocument.__heroWaveLifecycleBound = true
    document.addEventListener('astro:page-load', mountHeroWaves)
    document.addEventListener('astro:before-swap', destroyHeroWaves as EventListener)
    window.addEventListener('pagehide', destroyHeroWaves, { passive: true })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountHeroWaves, { once: true })
  } else {
    mountHeroWaves()
  }
</script>

<style lang="scss">
  .hero-wave {
    --hero-wave-rgb: 255,255,255;
    --wave-x: 50%;
    --wave-y: 46%;
    --wave-energy: 0;

    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
    contain: layout paint style;
  }

  .hero-wave__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: .98;
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 6%, #000 91%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 6%, #000 91%, transparent 100%);
  }

  .hero-wave__focus {
    position: absolute;
    inset: -14%;
    opacity: calc(.2 + var(--wave-energy) * .24);
    background:
      radial-gradient(
        circle at var(--wave-x) var(--wave-y),
        rgb(255 255 255 / calc(.08 + var(--wave-energy) * .055)) 0%,
        rgb(255 255 255 / calc(.035 + var(--wave-energy) * .025)) 14%,
        transparent 34%
      ),
      radial-gradient(
        ellipse 52% 40% at var(--wave-x) var(--wave-y),
        rgb(255 54 93 / calc(.025 + var(--wave-energy) * .045)),
        transparent 72%
      );
    filter: blur(5px);
    will-change: opacity;
  }

  .hero-wave__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / .18), transparent 14%, transparent 86%, rgb(0 0 0 / .18)),
      linear-gradient(180deg, rgb(0 0 0 / .08), transparent 22%, transparent 76%, rgb(0 0 0 / .22));
  }

  .hero-wave.is-fallback {
    background:
      radial-gradient(circle at 50% 46%, rgb(255 255 255 / .055), transparent 34%),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(2.2vw - 1px),
        rgb(255 255 255 / .09) calc(2.2vw - 1px),
        rgb(255 255 255 / .09) 2.2vw
      );
  }

  .hero-wave.is-fallback .hero-wave__canvas,
  .hero-wave.is-fallback .hero-wave__focus { display: none; }

  :global(.theme-contrasted) .hero-wave { --hero-wave-rgb: 12,13,16; }

  :global(.theme-contrasted) .hero-wave__focus {
    background:
      radial-gradient(circle at var(--wave-x) var(--wave-y), rgb(0 0 0 / .055), transparent 31%),
      radial-gradient(ellipse 52% 40% at var(--wave-x) var(--wave-y), rgb(255 54 93 / .045), transparent 72%);
    mix-blend-mode: multiply;
  }

  :global(.theme-contrasted) .hero-wave__vignette {
    background:
      linear-gradient(90deg, rgb(255 255 255 / .2), transparent 14%, transparent 86%, rgb(255 255 255 / .2)),
      linear-gradient(180deg, rgb(255 255 255 / .05), transparent 22%, transparent 76%, rgb(255 255 255 / .18));
  }

  @media (max-width: 699px), (pointer: coarse) {
    .hero-wave__canvas { opacity: .84; }
    .hero-wave__focus { opacity: .14; filter: blur(9px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave__focus { display: none; }
    .hero-wave__canvas { opacity: .72; }
  }
</style>
