---
const { class: className } = Astro.props
---

<div class:list={['hero-wave', className]} data-hero-wave aria-hidden="true">
  <canvas class="hero-wave__canvas"></canvas>
  <div class="hero-wave__focus"></div>
  <div class="hero-wave__vignette"></div>
</div>

<script>
  import { HeroWaveEngine } from '../utils/HeroWaveEngine'

  const mountHeroWaves = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-wave]').forEach((host) => {
      if (host.dataset.waveMounted === 'true') return
      host.dataset.waveMounted = 'true'

      try {
        const engine = new HeroWaveEngine(host)
        ;(host as HTMLElement & { waveEngine?: HeroWaveEngine }).waveEngine = engine
      } catch {
        host.classList.add('is-fallback')
      }
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountHeroWaves, { once: true })
  } else {
    mountHeroWaves()
  }
</script>

<style lang="scss">
  .hero-wave {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: layout paint style;

    &__canvas,
    &__vignette {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    &__canvas {
      display: block;
      opacity: .92;
      transform: translateZ(0);
    }

    &__focus {
      position: absolute;
      top: 0;
      left: 0;
      width: clamp(360px, 50vw, 760px);
      aspect-ratio: 1;
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          color(accent, .135) 0,
          color(accent, .072) 20%,
          color(accent, .025) 46%,
          transparent 70%
        );
      opacity: .54;
      mix-blend-mode: screen;
      transform: translate3d(0, 0, 0);
      transform-origin: 50% 50%;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }

    &__vignette {
      background:
        linear-gradient(90deg, color(primary, .55), transparent 14%, transparent 86%, color(primary, .55)),
        linear-gradient(180deg, color(primary, .18), transparent 26%, transparent 70%, color(primary, .52));
    }

    &.is-fallback {
      background:
        repeating-linear-gradient(90deg, color(secondary, .11) 0 1px, transparent 1px 24px),
        radial-gradient(circle at 52% 44%, color(accent, .1), transparent 34%);
    }
  }

  :global(.theme-contrasted) .hero-wave__focus {
    mix-blend-mode: multiply;
    opacity: .42;
  }

  :global(.theme-contrasted) .hero-wave__vignette {
    background:
      linear-gradient(90deg, color(primary, .4), transparent 14%, transparent 86%, color(primary, .4)),
      linear-gradient(180deg, color(primary, .08), transparent 26%, transparent 70%, color(primary, .38));
  }

  @media (max-width: 900px) {
    .hero-wave__canvas { opacity: .84; }
    .hero-wave__focus { width: clamp(330px, 68vw, 620px); }
  }

  @media (max-width: 560px) {
    .hero-wave__canvas { opacity: .79; }
    .hero-wave__focus { width: clamp(300px, 88vw, 480px); }
    .hero-wave__vignette {
      background:
        linear-gradient(90deg, color(primary, .42), transparent 18%, transparent 82%, color(primary, .42)),
        linear-gradient(180deg, color(primary, .1), transparent 30%, transparent 68%, color(primary, .48));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave__focus { will-change: auto; }
  }
</style>
