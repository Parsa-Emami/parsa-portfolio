---
const { class: className } = Astro.props
---

<div class:list={['hero-wave', className]} data-hero-wave aria-hidden="true">
  <canvas class="hero-wave__canvas"></canvas>
  <div class="hero-wave__focus"></div>
  <div class="hero-wave__vignette"></div>
</div>

<script>
  import { HeroWaveEngine } from '../utils/HeroWaveEngine'

  type WaveHost = HTMLElement & { __heroWaveEngine?: HeroWaveEngine }
  type LifecycleDocument = Document & { __heroWaveLifecycleBound?: boolean }

  const getHosts = () => document.querySelectorAll<WaveHost>('[data-hero-wave]')

  const mountHeroWaves = () => {
    getHosts().forEach((host) => {
      if (host.__heroWaveEngine) return

      try {
        host.__heroWaveEngine = new HeroWaveEngine(host)
        host.dataset.waveMounted = 'true'
      } catch (error) {
        host.classList.add('is-fallback')
        host.dataset.waveMounted = 'fallback'
        console.warn('[hero-wave] Canvas engine unavailable; using CSS fallback.', error)
      }
    })
  }

  const destroyHeroWaves = () => {
    getHosts().forEach((host) => {
      host.__heroWaveEngine?.destroy()
      delete host.__heroWaveEngine
      delete host.dataset.waveMounted
    })
  }

  const lifecycleDocument = document as LifecycleDocument
  if (!lifecycleDocument.__heroWaveLifecycleBound) {
    lifecycleDocument.__heroWaveLifecycleBound = true
    document.addEventListener('astro:page-load', mountHeroWaves)
    document.addEventListener('astro:before-swap', destroyHeroWaves as EventListener)
    window.addEventListener('pagehide', destroyHeroWaves, { passive: true })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountHeroWaves, { once: true })
  } else {
    mountHeroWaves()
  }
</script>

<style lang="scss">
  .hero-wave {
    --hero-wave-rgb: 255,255,255;
    --wave-x: 50%;
    --wave-y: 46%;
    --wave-energy: 0;

    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
    contain: layout paint style;
  }

  .hero-wave__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.96;
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 7%,
      #000 89%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 7%,
      #000 89%,
      transparent 100%
    );
  }

  .hero-wave__focus {
    position: absolute;
    inset: -18%;
    opacity: calc(0.18 + var(--wave-energy) * 0.18);
    background:
      radial-gradient(
        circle at var(--wave-x) var(--wave-y),
        rgb(255 255 255 / 0.085) 0%,
        rgb(255 255 255 / 0.035) 13%,
        transparent 31%
      ),
      radial-gradient(
        ellipse 48% 38% at var(--wave-x) var(--wave-y),
        rgb(255 255 255 / 0.035),
        transparent 72%
      );
    filter: blur(5px);
    transition: opacity 240ms ease-out;
    will-change: opacity;
  }

  .hero-wave__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.2), transparent 14%, transparent 86%, rgb(0 0 0 / 0.2)),
      linear-gradient(180deg, rgb(0 0 0 / 0.11), transparent 24%, transparent 76%, rgb(0 0 0 / 0.22));
  }

  .hero-wave.is-fallback {
    background:
      radial-gradient(circle at 50% 46%, rgb(255 255 255 / 0.05), transparent 34%),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(2.2vw - 1px),
        rgb(255 255 255 / 0.09) calc(2.2vw - 1px),
        rgb(255 255 255 / 0.09) 2.2vw
      );
  }

  .hero-wave.is-fallback .hero-wave__canvas,
  .hero-wave.is-fallback .hero-wave__focus {
    display: none;
  }

  @media (max-width: 699px), (pointer: coarse) {
    .hero-wave__canvas {
      opacity: 0.82;
    }

    .hero-wave__focus {
      opacity: 0.12;
      filter: blur(9px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave__focus {
      display: none;
    }

    .hero-wave__canvas {
      opacity: 0.72;
    }
  }
</style>
