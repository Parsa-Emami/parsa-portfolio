---
interface Props {
  variant?: 'brand' | 'orbit' | 'kernel' | 'profile' | 'navigation' | 'footer'
  class?: string
  label?: string
}
const { variant = 'brand', class: className = '', label } = Astro.props
const hidden = !label
---

<span class:list={['icon-glyph', `icon-glyph--${variant}`, className]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={hidden ? 'true' : undefined}>
  <svg viewBox="0 0 48 48" fill="none" focusable="false">
    {variant === 'brand' && (
      <g>
        <path d="M24 4.75 40.67 14.4v19.2L24 43.25 7.33 33.6V14.4L24 4.75Z" class="icon-glyph__frame" />
        <path d="M15.3 29.8 24 14.2l8.7 15.6H15.3Z" />
        <path d="M18.65 25.25h10.7M24 14.2v19.6" class="icon-glyph__fine" />
        <circle cx="24" cy="24" r="2.15" class="icon-glyph__node" />
      </g>
    )}
    {variant === 'orbit' && (
      <g>
        <circle cx="24" cy="24" r="16.5" class="icon-glyph__frame" />
        <path d="M7.5 24h33M24 7.5v33" class="icon-glyph__fine" />
        <path d="M12.4 17.1c6.8 5.3 16.4 8.4 23.2 13.8M12.4 30.9c6.8-5.3 16.4-8.4 23.2-13.8" />
        <circle cx="24" cy="24" r="3.1" class="icon-glyph__node" />
        <circle cx="35.6" cy="17.1" r="1.7" class="icon-glyph__node" />
      </g>
    )}
    {variant === 'kernel' && (
      <g>
        <path d="M24 6.5 38.9 15v18L24 41.5 9.1 33V15L24 6.5Z" class="icon-glyph__frame" />
        <path d="M24 13.2 33.2 24 24 34.8 14.8 24 24 13.2Z" />
        <path d="M9.1 15 24 24 38.9 15M9.1 33 24 24l14.9 9" class="icon-glyph__fine" />
        <circle cx="24" cy="24" r="2.4" class="icon-glyph__node" />
      </g>
    )}
    {variant === 'profile' && (
      <g>
        <circle cx="24" cy="24" r="17" class="icon-glyph__frame" />
        <path d="M24 11.5v25M11.5 24h25" class="icon-glyph__fine" />
        <path d="M16.5 31.2c1.8-4.6 5-7.2 7.5-7.2s5.7 2.6 7.5 7.2M19.1 18.1a4.9 4.9 0 1 0 9.8 0 4.9 4.9 0 0 0-9.8 0Z" />
        <circle cx="36.5" cy="24" r="1.55" class="icon-glyph__node" />
      </g>
    )}
    {variant === 'navigation' && (
      <g>
        <circle cx="24" cy="24" r="17" class="icon-glyph__frame" />
        <path d="m29.2 13.6-3.5 10.1-10.1 3.5 6.7-6.7 6.9-6.9Z" />
        <path d="m18.8 34.4 3.5-10.1 10.1-3.5-6.7 6.7-6.9 6.9Z" class="icon-glyph__fine" />
        <circle cx="24" cy="24" r="2.2" class="icon-glyph__node" />
      </g>
    )}
    {variant === 'footer' && (
      <g>
        <path d="M8.5 10.5h31v27h-31v-27Z" class="icon-glyph__frame" />
        <path d="m14.2 18.2 5.8 5.8-5.8 5.8M23.3 29.8h9.8" />
        <path d="M8.5 15.7h31" class="icon-glyph__fine" />
        <circle cx="12.2" cy="13.1" r="1" class="icon-glyph__node" />
      </g>
    )}
  </svg>
</span>

<style>
  .icon-glyph { display:inline-grid; place-items:center; width:1em; height:1em; flex:0 0 auto; color:inherit; }
  .icon-glyph svg { display:block; width:100%; height:100%; overflow:visible; }
  .icon-glyph path, .icon-glyph circle { vector-effect:non-scaling-stroke; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .icon-glyph__frame { opacity:.62; }
  .icon-glyph__fine { opacity:.38; stroke-width:1; }
  .icon-glyph__node { fill:currentColor; stroke:none !important; }
</style>
