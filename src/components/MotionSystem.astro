<div class="ambient-field" data-ambient-field aria-hidden="true">
  <span class="ambient-field__blob ambient-field__blob--a"></span>
  <span class="ambient-field__blob ambient-field__blob--b"></span>
</div>

<div class="motion-light" data-motion-light aria-hidden="true"></div>

<div class="motion-chapter" aria-hidden="true">
  <span class="motion-chapter__eyebrow">NOW VIEWING</span>
  <span class="motion-chapter__name" data-section-name-current>Intro</span>
  <span class="motion-chapter__index" data-section-index-current>01 / 07</span>
</div>

<div class="motion-loader" data-motion-loader aria-hidden="true">
  <div class="motion-loader__top">
    <span>PE / PORTFOLIO SYSTEM</span>
    <span data-loader-counter>000</span>
  </div>
  <div class="motion-loader__word" data-loader-word>
    <span>PARSA</span><span>EMAMI</span>
  </div>
  <div class="motion-loader__rail"><span data-loader-rail></span></div>
</div>

<div class="motion-cursor" data-motion-cursor aria-hidden="true">
  <span class="motion-cursor__dot"></span>
  <span class="motion-cursor__ring"></span>
  <span class="motion-cursor__pulse" data-cursor-pulse></span>
  <span class="motion-cursor__label" data-cursor-label></span>
</div>

<div class="motion-progress" aria-hidden="true">
  <span class="motion-progress__label">SCROLL</span>
  <span class="motion-progress__rail"><i data-scroll-progress></i></span>
  <span class="motion-progress__value" data-scroll-value>00</span>
</div>

<script>
  import Lenis from 'lenis'
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'

  gsap.registerPlugin(ScrollTrigger, SplitText)

  // Prevents ScrollTrigger from recalculating (and stuttering) every time a
  // mobile browser's address bar shows/hides and resizes the viewport.
  ScrollTrigger.config({ ignoreMobileResize: true })

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const coarsePointer = window.matchMedia('(pointer: coarse)').matches
  const desktop = window.matchMedia('(min-width: 901px)')
  const body = document.body
  const loader = document.querySelector('[data-motion-loader]')
  const loaderCounter = document.querySelector('[data-loader-counter]')
  const loaderRail = document.querySelector('[data-loader-rail]')
  const loaderWord = document.querySelector('[data-loader-word]')

  let lenis

  const bootSmoothScroll = () => {
    if (reduceMotion) return
    lenis = new Lenis({
      duration: 1.32,
      smoothWheel: true,
      syncTouch: false,
      wheelMultiplier: 0.86,
      touchMultiplier: 1.08,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    })
    lenis.on('scroll', ScrollTrigger.update)
    gsap.ticker.add((time) => lenis.raf(time * 1000))
    gsap.ticker.lagSmoothing(0)
    ;(window as any).__portfolioLenis = lenis
    lenis.stop()
  }

  const runLoader = () => {
    if (!loader) return Promise.resolve()
    if (reduceMotion) {
      loader.remove()
      body.classList.add('is-ready')
      return Promise.resolve()
    }

    return new Promise((resolve) => {
      const counter = { value: 0 }
      const main = document.querySelector('main')
      if (main) gsap.set(main, { scale: 1.045, filter: 'blur(9px)', transformOrigin: '50% 50%' })

      const tl = gsap.timeline({
        defaults: { ease: 'expo.inOut' },
        onComplete: () => {
          loader.remove()
          body.classList.add('is-ready')
          lenis?.start()
          if (main) gsap.set(main, { clearProps: 'transform,filter,transformOrigin' })
          resolve()
        },
      })

      tl.to(counter, {
        value: 100,
        duration: 1.05,
        ease: 'power3.out',
        onUpdate: () => {
          if (loaderCounter) loaderCounter.textContent = String(Math.round(counter.value)).padStart(3, '0')
          if (loaderRail) loaderRail.style.transform = `scaleX(${counter.value / 100})`
        },
      })
      tl.fromTo(loaderWord?.children || [], { yPercent: 120 }, { yPercent: 0, stagger: 0.08, duration: 0.82 }, 0.12)
      tl.to(loaderWord?.children || [], { yPercent: -120, stagger: 0.04, duration: 0.62 }, 0.9)
      tl.to(loader, { clipPath: 'inset(0 0 100% 0)', duration: 0.82 }, 1.08)
      if (main) tl.to(main, { scale: 1, filter: 'blur(0px)', duration: 1.0, ease: 'expo.out' }, 1.02)
    })
  }

  const initHeroField = () => {
    const canvas = document.querySelector('[data-hero-field]')
    if (!(canvas instanceof HTMLCanvasElement) || reduceMotion) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    let width = 0
    let height = 0
    let raf = 0
    let active = true
    let time = 0
    const mouse = { x: 0, y: 0, tx: 0, ty: 0 }
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5)

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      width = rect.width
      height = rect.height
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      mouse.x = mouse.tx = width * 0.5
      mouse.y = mouse.ty = height * 0.5
    }

    const pointer = (event) => {
      const rect = canvas.getBoundingClientRect()
      mouse.tx = event.clientX - rect.left
      mouse.ty = event.clientY - rect.top
    }

    const draw = () => {
      if (!active) return
      raf = requestAnimationFrame(draw)
      time += 0.012
      mouse.x += (mouse.tx - mouse.x) * 0.055
      mouse.y += (mouse.ty - mouse.y) * 0.055
      ctx.clearRect(0, 0, width, height)

      const style = getComputedStyle(document.documentElement)
      const stroke = style.getPropertyValue('--color-secondary').trim() || '#f1eee8'
      const accent = style.getPropertyValue('--color-accent').trim() || '#ff3158'
      const cols = Math.max(18, Math.floor(width / 30))
      const rows = Math.max(11, Math.floor(height / 42))
      const gapX = width / (cols - 1)
      const gapY = height / (rows - 1)

      ctx.lineWidth = 0.75
      ctx.globalAlpha = 0.18
      ctx.strokeStyle = stroke

      for (let c = 0; c < cols; c++) {
        ctx.beginPath()
        for (let r = 0; r < rows; r++) {
          const bx = c * gapX
          const by = r * gapY
          const dx = bx - mouse.x
          const dy = by - mouse.y
          const dist = Math.max(1, Math.hypot(dx, dy))
          const force = Math.max(0, 1 - dist / 260)
          const nx = bx + Math.sin(time * 1.35 + r * 0.48 + c * 0.12) * 14 + (dx / dist) * force * 38
          const ny = by + Math.cos(time + c * 0.28 + r * 0.2) * 8 + (dy / dist) * force * 26
          if (r === 0) ctx.moveTo(nx, ny)
          else ctx.lineTo(nx, ny)
        }
        ctx.stroke()
      }

      ctx.globalAlpha = 0.82
      ctx.fillStyle = accent
      ctx.beginPath()
      ctx.arc(mouse.x, mouse.y, 2.4, 0, Math.PI * 2)
      ctx.fill()
      ctx.globalAlpha = 1
    }

    const observer = new IntersectionObserver(([entry]) => {
      active = entry.isIntersecting
      cancelAnimationFrame(raf)
      if (active) draw()
    }, { threshold: 0.01 })

    resize()
    window.addEventListener('resize', resize)
    window.addEventListener('pointermove', pointer, { passive: true })
    observer.observe(canvas)
    draw()
  }

  const initCursor = () => {
    if (coarsePointer || reduceMotion) return
    const cursor = document.querySelector('[data-motion-cursor]')
    const ring = cursor?.querySelector('.motion-cursor__ring')
    const dot = cursor?.querySelector('.motion-cursor__dot')
    const label = document.querySelector('[data-cursor-label]')
    if (!cursor || !ring || !dot) return

    const pos = { x: window.innerWidth / 2, y: window.innerHeight / 2 }
    const smooth = { x: pos.x, y: pos.y }

    window.addEventListener('pointermove', (event) => {
      pos.x = event.clientX
      pos.y = event.clientY
      gsap.set(dot, { x: pos.x, y: pos.y })
    }, { passive: true })

    gsap.ticker.add(() => {
      smooth.x += (pos.x - smooth.x) * 0.16
      smooth.y += (pos.y - smooth.y) * 0.16
      gsap.set(ring, { x: smooth.x, y: smooth.y })
      if (label) gsap.set(label, { x: smooth.x + 24, y: smooth.y - 24 })
    })

    document.querySelectorAll('[data-cursor]').forEach((element) => {
      element.addEventListener('pointerenter', () => {
        cursor.classList.add('is-active')
        if (label) label.textContent = element.getAttribute('data-cursor') || ''
      })
      element.addEventListener('pointerleave', () => {
        cursor.classList.remove('is-active')
        if (label) label.textContent = ''
      })
    })

    // A short-lived expanding ring on every click/tap gives pointer input a
    // satisfying, tactile confirmation without ever blocking the click itself.
    const pulse = document.querySelector('[data-cursor-pulse]')
    if (pulse) {
      window.addEventListener('pointerdown', (event) => {
        gsap.killTweensOf(pulse)
        gsap.set(pulse, { x: event.clientX, y: event.clientY, xPercent: -50, yPercent: -50, scale: 0.3, opacity: 0.65 })
        gsap.to(pulse, { scale: 1.8, opacity: 0, duration: .65, ease: 'power2.out' })
      }, { passive: true })
    }
  }

  const initGlobalReveals = () => {
    if (reduceMotion) return

    document.querySelectorAll('[data-reveal]').forEach((element, index) => {
      gsap.fromTo(element,
        { y: 54, opacity: 0, scale: .975, filter: 'blur(14px)' },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          filter: 'blur(0px)',
          duration: 1.3,
          delay: (index % 3) * 0.04,
          ease: 'expo.out',
          scrollTrigger: { trigger: element, start: 'top 88%', once: true },
        }
      )
    })

    document.querySelectorAll('[data-split-reveal]').forEach((element) => {
      const split = new SplitText(element, { type: 'lines', linesClass: 'motion-line' })
      split.lines.forEach((line) => {
        const inner = document.createElement('span')
        inner.className = 'motion-line__inner'
        while (line.firstChild) inner.appendChild(line.firstChild)
        line.appendChild(inner)
      })
      gsap.fromTo(element.querySelectorAll('.motion-line__inner'),
        { yPercent: 118, rotate: 2, filter: 'blur(9px)' },
        {
          yPercent: 0,
          rotate: 0,
          filter: 'blur(0px)',
          duration: 1.35,
          stagger: 0.075,
          ease: 'expo.out',
          scrollTrigger: { trigger: element, start: 'top 86%', once: true },
        }
      )
    })

    document.querySelectorAll('[data-parallax]').forEach((element) => {
      const amount = Number(element.getAttribute('data-parallax')) || 12
      gsap.fromTo(element, { yPercent: -amount }, {
        yPercent: amount,
        ease: 'none',
        scrollTrigger: { trigger: element, start: 'top bottom', end: 'bottom top', scrub: 1 },
      })
    })
  }

  const initHeroMotion = () => {
    if (reduceMotion) return
    const hero = document.querySelector('.hero')
    if (!hero) return
    const lines = hero.querySelectorAll('[data-hero-line]')
    const meta = hero.querySelectorAll('[data-hero-meta]')
    const orbit = hero.querySelector('[data-hero-orbit]')

    gsap.set(lines, { yPercent: 115, rotate: 3, filter: 'blur(18px)' })
    gsap.set(meta, { opacity: 0, y: 24 })
    gsap.timeline({ delay: 0.05 })
      .to(lines, { yPercent: 0, rotate: 0, filter: 'blur(0px)', duration: 1.55, stagger: 0.12, ease: 'expo.out' })
      .to(meta, { opacity: 1, y: 0, duration: 0.85, stagger: 0.08, ease: 'power3.out' }, '-=0.85')
      .fromTo(orbit, { scale: 0.65, rotate: -45, opacity: 0 }, { scale: 1, rotate: 0, opacity: 1, duration: 1.3, ease: 'expo.out' }, '-=1.15')

    gsap.to(hero.querySelector('[data-hero-title-a]'), {
      xPercent: -8,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 },
    })
    gsap.to(hero.querySelector('[data-hero-title-b]'), {
      xPercent: 7,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 },
    })
    gsap.to(hero.querySelector('[data-hero-orbit]'), {
      rotate: 130,
      yPercent: 35,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 },
    })
  }

  const initManifestMotion = () => {
    if (reduceMotion || !desktop.matches) return
    const section = document.querySelector('.manifest')
    const pin = section?.querySelector('[data-manifest-pin]')
    const beats = section?.querySelectorAll('[data-manifest-beat]')
    const meter = section?.querySelector('[data-manifest-meter]')
    const current = section?.querySelector('[data-manifest-current]')
    const core = section?.querySelector('[data-manifest-core]')
    const ghost = section?.querySelector('.manifest__ghost')
    if (!section || !pin || !beats?.length) return

    beats.forEach((beat, index) => {
      if (index === 0) gsap.set(beat, { autoAlpha: 1, y: 0, filter: 'blur(0px)' })
      else gsap.set(beat, { autoAlpha: 0, y: 44, filter: 'blur(12px)' })
    })

    const setCurrent = (index) => {
      beats.forEach((beat, beatIndex) => beat.classList.toggle('is-active', beatIndex === index))
      if (current) current.textContent = String(index + 1).padStart(2, '0')
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        pin,
        pinSpacing: false,
        scrub: 0.9,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => setCurrent(Math.min(beats.length - 1, Math.floor(self.progress * beats.length))),
      },
    })

    beats.forEach((beat, index) => {
      if (index === 0) return
      const previous = beats[index - 1]
      tl.to(previous, { autoAlpha: 0, y: -44, filter: 'blur(12px)', duration: .48, ease: 'none' })
        .fromTo(beat,
          { autoAlpha: 0, y: 44, filter: 'blur(12px)' },
          { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: .52, ease: 'none' },
          '<.12'
        )
      if (meter) tl.to(meter, { scaleX: (index + 1) / beats.length, duration: .52, ease: 'none' }, '<')
    })

    if (core) {
      gsap.to(core, {
        rotate: 300,
        scale: 1.12,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top top', end: 'bottom bottom', scrub: 1.2 },
      })
    }
    if (ghost) {
      gsap.fromTo(ghost, { xPercent: -4 }, {
        xPercent: 4,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top top', end: 'bottom bottom', scrub: 1.4 },
      })
    }
  }

  const initAboutMotion = () => {
    if (reduceMotion || !desktop.matches) return
    const section = document.querySelector('.about')
    if (!section) return
    const words = section.querySelectorAll('[data-orbit-word]')
    const core = section.querySelector('[data-about-core]')

    gsap.to(words, {
      rotate: (index) => (index % 2 ? -15 : 15),
      xPercent: (index) => (index - 1) * 8,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1.2 },
    })
    gsap.to(core, {
      rotate: 180,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1.4 },
    })
  }

  const initSystemsMotion = () => {
    if (reduceMotion || !desktop.matches) return
    const section = document.querySelector('.systems')
    const pin = section?.querySelector('.systems__pin')
    const cards = section?.querySelectorAll('.system-card')
    const meter = section?.querySelector('[data-system-meter]')
    if (!section || !pin || !cards?.length) return

    gsap.set(cards, { transformOrigin: '50% 90%' })
    cards.forEach((card, index) => {
      if (index > 0) gsap.set(card, { yPercent: 112, rotate: 5 + index * 1.4, scale: 0.98 })
    })

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => `+=${Math.max(2400, cards.length * window.innerHeight * 0.95)}`,
        pin,
        scrub: 1,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      },
    })

    cards.forEach((card, index) => {
      if (index === 0) return
      const previous = cards[index - 1]
      tl.to(previous, { yPercent: -5, scale: 0.92, rotate: -1.5, opacity: 0.5, duration: 1, ease: 'none' })
        .to(card, { yPercent: 0, scale: 1, rotate: 0, duration: 1, ease: 'none' }, '<')
      if (meter) tl.to(meter, { scaleX: (index + 1) / cards.length, duration: 1, ease: 'none' }, '<')
    })
  }

  const initOpenSourceMotion = () => {
    if (reduceMotion || !desktop.matches) return
    const section = document.querySelector('.oss')
    const track = section?.querySelector('.oss__track')
    if (!section || !track) return

    const getDistance = () => Math.max(0, track.scrollWidth - window.innerWidth + 80)
    const horizontalTween = gsap.to(track, {
      x: () => -getDistance(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => `+=${getDistance() * 1.35 + window.innerHeight * 0.6}`,
        pin: section.querySelector('.oss__pin'),
        scrub: 1,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      },
    })

    section.querySelectorAll('.oss-card').forEach((card, index) => {
      gsap.fromTo(card,
        { rotate: index % 2 ? 2.5 : -2.5, y: index % 2 ? 26 : -18 },
        {
          rotate: 0,
          y: 0,
          ease: 'none',
          scrollTrigger: { trigger: card, containerAnimation: horizontalTween, start: 'left 92%', end: 'center 58%', scrub: 1 },
        }
      )
    })
  }

  const initExperienceMotion = () => {
    const section = document.querySelector('.experience')
    const line = section?.querySelector('[data-timeline-line]')
    if (!section || !line || reduceMotion) return
    gsap.fromTo(line, { scaleY: 0 }, {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top 70%', end: 'bottom 65%', scrub: 1 },
    })

    section.querySelectorAll('.timeline-item').forEach((item, index) => {
      gsap.fromTo(item,
        { x: index % 2 ? 42 : -18, opacity: 0.2 },
        {
          x: 0,
          opacity: 1,
          ease: 'power2.out',
          scrollTrigger: { trigger: item, start: 'top 88%', end: 'top 62%', scrub: 0.7 },
        }
      )
    })
  }

  const initCTAMotion = () => {
    const section = document.querySelector('.cta')
    if (!section || reduceMotion) return
    const words = section.querySelectorAll('[data-cta-word]')
    words.forEach((word, index) => {
      gsap.fromTo(word,
        { xPercent: index % 2 ? 38 : -38 },
        {
          xPercent: 0,
          ease: 'none',
          scrollTrigger: { trigger: section, start: 'top bottom', end: 'center center', scrub: 1 },
        }
      )
    })
  }

  const initAmbientField = () => {
    if (reduceMotion) return
    const field = document.querySelector('[data-ambient-field]')
    const blobA = field?.querySelector('.ambient-field__blob--a')
    const blobB = field?.querySelector('.ambient-field__blob--b')
    if (!field || !blobA || !blobB) return

    // A slow scroll-tied parallax gives the whole page a sense of depth and
    // gently rewards continued scrolling — runs on every device since it's
    // just two cheap transforms.
    gsap.to(blobA, {
      yPercent: 22,
      xPercent: -6,
      ease: 'none',
      scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 1.4 },
    })
    gsap.to(blobB, {
      yPercent: -18,
      xPercent: 8,
      ease: 'none',
      scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 1.4 },
    })

    // On top of that, desktop pointers nudge the blobs toward the cursor for
    // a subtle, expensive-feeling parallax that costs almost nothing.
    if (!coarsePointer && desktop.matches) {
      const moveA = gsap.quickTo(blobA, 'x', { duration: 1.4, ease: 'power3.out' })
      const moveAY = gsap.quickTo(blobA, 'y', { duration: 1.4, ease: 'power3.out' })
      const moveB = gsap.quickTo(blobB, 'x', { duration: 1.8, ease: 'power3.out' })
      const moveBY = gsap.quickTo(blobB, 'y', { duration: 1.8, ease: 'power3.out' })
      window.addEventListener('pointermove', (event) => {
        const nx = (event.clientX / window.innerWidth - 0.5) * 2
        const ny = (event.clientY / window.innerHeight - 0.5) * 2
        moveA(nx * 34)
        moveAY(ny * 34)
        moveB(nx * -26)
        moveBY(ny * -26)
      }, { passive: true })
    }
  }

  // Sections like `.systems` and `.oss` pin/scrub on desktop but fall back to
  // a plain stacked layout on phones and small tablets, where pinning tends
  // to fight the browser's own momentum scroll. Give that stacked layout its
  // own light, non-pinned reveal so the mobile experience still feels
  // motion-directed instead of static.
  const initMobileCardReveals = () => {
    if (reduceMotion || desktop.matches) return
    const cards = document.querySelectorAll(
      '.system-card, .oss-card, .oss__lead-card, .oss__end-card'
    )
    cards.forEach((card, index) => {
      gsap.fromTo(card,
        { y: 46, opacity: 0, scale: 0.985, filter: 'blur(10px)' },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          filter: 'blur(0px)',
          duration: 0.9,
          delay: (index % 2) * 0.05,
          ease: 'power3.out',
          scrollTrigger: { trigger: card, start: 'top 92%', once: true },
        }
      )
    })
  }

  // Gives cards a light, physically-plausible tilt toward the pointer —
  // desktop only, and skipped for anything already animated by a pinned
  // ScrollTrigger timeline that owns its own transform (handled by composing
  // rotationX/Y/Z on top of whatever x/y/rotate that timeline is driving).
  const initTilt = () => {
    if (coarsePointer || reduceMotion || !desktop.matches) return
    document.querySelectorAll('[data-tilt]').forEach((card) => {
      if (!(card instanceof HTMLElement)) return
      const strength = Number(card.getAttribute('data-tilt')) || 6
      const inheritsPerspective = card.getAttribute('data-tilt-perspective') === 'inherit'
      if (!inheritsPerspective) gsap.set(card, { transformPerspective: 950 })
      gsap.set(card, { transformStyle: 'preserve-3d' })

      const setRX = gsap.quickTo(card, 'rotationX', { duration: .7, ease: 'power3.out' })
      const setRY = gsap.quickTo(card, 'rotationY', { duration: .7, ease: 'power3.out' })
      const setZ = gsap.quickTo(card, 'z', { duration: .7, ease: 'power3.out' })

      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect()
        const px = (event.clientX - rect.left) / rect.width - 0.5
        const py = (event.clientY - rect.top) / rect.height - 0.5
        setRY(px * strength)
        setRX(py * -strength)
        setZ(16)
      })
      card.addEventListener('pointerleave', () => {
        setRX(0)
        setRY(0)
        setZ(0)
      })
    })
  }

  const initMagnetic = () => {
    if (coarsePointer || reduceMotion) return
    document.querySelectorAll('[data-magnetic]').forEach((element) => {
      element.addEventListener('pointermove', (event) => {
        const rect = element.getBoundingClientRect()
        const x = event.clientX - rect.left - rect.width / 2
        const y = event.clientY - rect.top - rect.height / 2
        gsap.to(element, { x: x * 0.16, y: y * 0.16, duration: 0.35, ease: 'power2.out' })
      })
      element.addEventListener('pointerleave', () => {
        gsap.to(element, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.45)' })
      })
    })
  }

  const initPointerLight = () => {
    if (coarsePointer || reduceMotion) return
    const light = document.querySelector('[data-motion-light]')
    if (!light) return
    const moveX = gsap.quickTo(light, 'x', { duration: 1.1, ease: 'power3.out' })
    const moveY = gsap.quickTo(light, 'y', { duration: 1.1, ease: 'power3.out' })
    window.addEventListener('pointermove', (event) => {
      moveX(event.clientX)
      moveY(event.clientY)
    }, { passive: true })
  }

  const initSectionHUD = () => {
    const name = document.querySelector('[data-section-name-current]')
    const index = document.querySelector('[data-section-index-current]')
    const sections = Array.from(document.querySelectorAll('[data-section-name]'))
    if (!name || !index || !sections.length) return

    const update = (section) => {
      const currentIndex = sections.indexOf(section)
      name.textContent = section.getAttribute('data-section-name') || 'Portfolio'
      index.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(sections.length).padStart(2, '0')}`
    }

    const observer = new IntersectionObserver((entries) => {
      const visible = entries.find((entry) => entry.isIntersecting)
      if (visible) update(visible.target)
    }, { rootMargin: '-48% 0px -48% 0px', threshold: 0 })
    sections.forEach((section) => observer.observe(section))
  }

  const initProgress = () => {
    const bar = document.querySelector('[data-scroll-progress]')
    const value = document.querySelector('[data-scroll-value]')
    if (!bar || !value) return
    const update = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight)
      const progress = Math.min(1, Math.max(0, window.scrollY / max))
      bar.style.transform = `scaleY(${progress})`
      value.textContent = String(Math.round(progress * 100)).padStart(2, '0')
    }
    update()
    window.addEventListener('scroll', update, { passive: true })
  }

  const init = async () => {
    bootSmoothScroll()
    initHeroField()
    initCursor()
    initPointerLight()
    initProgress()
    initSectionHUD()
    initAmbientField()
    await runLoader()
    initHeroMotion()
    initGlobalReveals()
    initManifestMotion()
    initAboutMotion()
    initSystemsMotion()
    initOpenSourceMotion()
    initMobileCardReveals()
    initExperienceMotion()
    initCTAMotion()
    initMagnetic()
    initTilt()
    requestAnimationFrame(() => ScrollTrigger.refresh())
  }

  init()

  window.addEventListener('portfolio-theme-change', () => {
    requestAnimationFrame(() => ScrollTrigger.refresh())
  })
</script>

