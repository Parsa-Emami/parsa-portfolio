---
import { capabilities, profile } from '../data/portfolio'
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="site-shell">
    <div class="section-heading" data-reveal>
      <span class="section-number">01</span>
      <p class="section-kicker">Profile / Engineering approach</p>
      <h2 id="about-title">I work where software logic, security boundaries, and real-world constraints collide.</h2>
    </div>

    <div class="about__lead" data-reveal>
      <p class="about__statement">
        My work spans production software, security architecture, red-team thinking, testing, and applied AI. I care about making hidden rules explicit, giving complex systems one reliable source of truth, and keeping technical decisions understandable under change.
      </p>
      <div class="about__meta">
        <div><span>CURRENT</span><strong>{profile.company}</strong></div>
        <div><span>ACADEMIC</span><strong>M.Eng. Artificial Intelligence</strong></div>
        <div><span>BASE</span><strong>{profile.location}</strong></div>
      </div>
    </div>

    <div class="about__capabilities">
      {
        capabilities.map((item) => (
          <article class="about__capability" data-reveal>
            <div class="about__capability-head">
              <span>{item.index}</span>
              <span aria-hidden="true">↘</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .about {
    &__lead {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
      gap: clamp(2rem, 7vw, 7rem);
      margin-top: clamp(3rem, 7vw, 6rem);
      padding-top: 2rem;
      border-top: 1px solid color(shadow);
    }

    &__statement {
      max-width: 58rem;
      margin: 0;
      font: 200 clamp(2rem, 4.4vw, 4.6rem) / 1.02 font-family(editorial);
      letter-spacing: -0.045em;
    }

    &__meta {
      align-self: end;
      display: grid;
      border-top: 1px solid color(shadow);

      div {
        display: grid;
        gap: 0.35rem;
        padding: 1rem 0;
        border-bottom: 1px solid color(shadow);
      }

      span {
        color: color(accent);
        font: 400 0.63rem / 1 font-family(fraktion);
        letter-spacing: 0.07em;
      }

      strong {
        color: color(secondary);
        font: 400 0.9rem / 1.35 font-family(fraktion);
      }
    }

    &__capabilities {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: clamp(4rem, 8vw, 8rem);
      border-top: 1px solid color(shadow);
      border-left: 1px solid color(shadow);
    }

    &__capability {
      min-height: 19rem;
      padding: clamp(1.2rem, 2.2vw, 2rem);
      border-right: 1px solid color(shadow);
      border-bottom: 1px solid color(shadow);
      transition: background 220ms ease, transform 220ms ease;

      &:hover {
        background: color(shadow);
        transform: translateY(-0.35rem);
      }

      h3 {
        max-width: 13rem;
        margin: clamp(3rem, 7vw, 5.5rem) 0 0;
        font: 200 clamp(1.8rem, 2.5vw, 2.65rem) / 0.98 font-family(editorial);
        letter-spacing: -0.04em;
      }

      p {
        max-width: 25rem;
        margin: 1rem 0 0;
        color: color(muted);
        font-size: 0.92rem;
        line-height: 1.52;
      }
    }

    &__capability-head {
      display: flex;
      justify-content: space-between;
      color: color(accent);
      font: 400 0.64rem / 1 font-family(fraktion);
      letter-spacing: 0.06em;
    }

    @media (max-width: 900px) {
      &__lead {
        grid-template-columns: 1fr;
      }

      &__capabilities {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 600px) {
      &__capabilities { grid-template-columns: 1fr; }
      &__capability { min-height: auto; }
      &__capability h3 { margin-top: 3.5rem; }
    }
  }
</style>
