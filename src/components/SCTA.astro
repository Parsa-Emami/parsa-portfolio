---
import { profile } from '../data/portfolio'
---

<section class="cta" id="contact" aria-labelledby="cta-title">
  <div class="cta__grid" aria-hidden="true"></div>
  <div class="site-shell cta__shell">
    <div class="cta__meta" data-reveal>
      <span>05 / CONTACT</span>
      <span>SOFTWARE · SECURITY · RED TEAM · AI</span>
      <span>OPEN TO SERIOUS ENGINEERING CONVERSATIONS</span>
    </div>

    <h2 id="cta-title" class="cta__title" aria-label="Build Break Secure">
      <span data-cta-word>BUILD</span>
      <span data-cta-word class="cta__outline">BREAK</span>
      <span data-cta-word>SECURE.</span>
    </h2>

    <div class="cta__bottom">
      <p data-split-reveal>
        The best systems survive change because their rules are explicit, their boundaries are defended, and their behavior can be explained.
      </p>

      <div class="cta__links" data-reveal>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-magnetic data-cursor="LinkedIn">
          <span><i>01</i> LinkedIn</span><b>START A CONVERSATION ↗</b>
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" data-magnetic data-cursor="GitHub">
          <span><i>02</i> GitHub</span><b>INSPECT PUBLIC CODE ↗</b>
        </a>
      </div>
    </div>
  </div>

  <div class="cta__marquee" aria-hidden="true">
    <div><span>PARSA EMAMI</span><i>✦</i><span>SOFTWARE ENGINEER</span><i>✦</i><span>SECURITY ARCHITECT</span><i>✦</i><span>RED TEAM</span><i>✦</i><span>PARSA EMAMI</span><i>✦</i><span>SOFTWARE ENGINEER</span><i>✦</i><span>SECURITY ARCHITECT</span><i>✦</i><span>RED TEAM</span><i>✦</i></div>
  </div>
</section>

<style lang="scss">
  .cta {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: color(accent);
    color: color(white);

    &__grid {
      position: absolute;
      inset: 0;
      opacity: .2;
      background-image: linear-gradient(rgba(255,255,255,.32) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.32) 1px, transparent 1px);
      background-size: clamp(3rem, 6vw, 7rem) clamp(3rem, 6vw, 7rem);
      mask-image: radial-gradient(circle at 55% 45%, #000, transparent 72%);
    }
    &__shell {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-height: calc(100svh - 2.7rem);
      padding-top: clamp(4rem, 8vh, 7rem);
      padding-bottom: clamp(3rem, 6vh, 5rem);
    }
    &__meta {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,.48);
      font: 700 .58rem/1.25 font-family(fraktion);
      letter-spacing: 0.112em;
      span:nth-child(2) { text-align: center; }
    }
    &__title {
      align-self: center;
      display: grid;
      margin: clamp(4rem, 9vh, 8rem) 0;
      font: 700 clamp(5.8rem, 18.5vw, 19rem)/.61 font-family(bigger);
      letter-spacing: -.078em;
      text-transform: uppercase;
      span { display: block; width: max-content; will-change: transform; }
      span:nth-child(2) { justify-self: end; }
      span:nth-child(3) { justify-self: center; }
    }
    &__outline { color: transparent; -webkit-text-stroke: clamp(1px, .13vw, 2px) color(white); }
    &__bottom {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(360px, 1.2fr);
      gap: clamp(3rem, 8vw, 8rem);
      align-items: end;
      > p { max-width: 40rem; margin: 0; font: 200 clamp(1.7rem, 3.3vw, 3.4rem)/.98 font-family(editorial); letter-spacing: -.045em; }
    }
    &__links { display: grid; border-top: 1px solid rgba(255,255,255,.55); }
    &__links a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid rgba(255,255,255,.55);
      color: color(white);
      font-family: font-family(fraktion);
      text-decoration: none;
      will-change: transform;
      span { font-size: .9rem; font-weight: 700; text-transform: uppercase; i { margin-right: .75rem; font-size: .55rem; opacity: .55; } }
      b { font-size: .57rem; font-weight: 700; letter-spacing: 0.098em; }
    }
    &__marquee {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      overflow: hidden;
      border-top: 1px solid rgba(255,255,255,.5);
      div { display: flex; gap: 1rem; align-items: center; width: max-content; padding: .72rem 0; animation: ctaTicker 20s linear infinite; font: 700 .58rem/1 font-family(fraktion); letter-spacing: 0.112em; }
      i { opacity: .55; }
    }
  }
  @keyframes ctaTicker { to { transform: translateX(-50%); } }

  @media (max-width: 800px) {
    .cta__meta { grid-template-columns: 1fr auto; }
    .cta__meta span:nth-child(2) { display: none; }
    .cta__title { font-size: clamp(5rem, 23vw, 10rem); }
    .cta__title span:nth-child(2), .cta__title span:nth-child(3) { justify-self: start; }
    .cta__bottom { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cta__links a { align-items: flex-start; flex-direction: column; gap: .5rem; }
  }
</style>
