---
import { profile } from '../data/portfolio'
---

<section class="cta section" id="contact" aria-labelledby="cta-title">
  <div class="site-shell">
    <div class="cta__top" data-reveal>
      <span>05 / CONTACT</span>
      <span>Available for meaningful engineering conversations</span>
    </div>

    <h2 id="cta-title" data-reveal>
      <span>BUILD</span>
      <span>SECURE</span>
      <span class="cta__outline">IMPROVE.</span>
    </h2>

    <div class="cta__bottom" data-reveal>
      <p>
        For software engineering, architecture, security, Red Team, or technically demanding product work, the best way to reach me is through LinkedIn.
      </p>
      <div class="cta__links">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
          <span>LinkedIn</span><span>Open profile ↗</span>
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">
          <span>GitHub</span><span>Inspect public code ↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .cta {
    position: relative;
    overflow: hidden;
    background: color(accent);
    color: color(white);

    &:before {
      position: absolute;
      inset: -20%;
      opacity: 0.15;
      background-image:
        linear-gradient(45deg, transparent 49.6%, color(white) 49.8%, color(white) 50.2%, transparent 50.4%);
      background-size: 6rem 6rem;
      content: '';
      pointer-events: none;
    }

    .site-shell { position: relative; z-index: 1; }

    &__top {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid color(white);
      font: 700 0.64rem / 1.3 font-family(fraktion);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    h2 {
      display: grid;
      margin: clamp(4rem, 8vw, 7rem) 0 0;
      font: 700 clamp(5rem, 16vw, 16rem) / 0.67 font-family(bigger);
      letter-spacing: -0.065em;
      text-transform: uppercase;

      span:nth-child(2) { justify-self: end; }
    }

    &__outline {
      color: transparent;
      -webkit-text-stroke: 1.5px color(white);
    }

    &__bottom {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(320px, 1.2fr);
      gap: clamp(3rem, 8vw, 8rem);
      align-items: end;
      margin-top: clamp(4rem, 8vw, 7rem);
      padding-top: 1.5rem;
      border-top: 1px solid color(white);

      > p {
        max-width: 34rem;
        margin: 0;
        font-size: clamp(1rem, 1.3vw, 1.2rem);
        line-height: 1.5;
      }
    }

    &__links {
      display: grid;

      a {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.2rem 0;
        border-top: 1px solid color(white);
        color: color(white);
        font-family: font-family(fraktion);
        text-decoration: none;
        transition: padding 180ms ease;

        &:hover { padding-left: 0.65rem; }

        span:first-child {
          font-size: 1rem;
          font-weight: 700;
          text-transform: uppercase;
        }

        span:last-child {
          font-size: 0.65rem;
          text-align: right;
          text-transform: uppercase;
        }
      }
    }

    @media (max-width: 700px) {
      &__top { flex-direction: column; gap: 0.4rem; }
      h2 span:nth-child(2) { justify-self: start; }
      &__bottom { grid-template-columns: 1fr; }
    }
  }
</style>
