---
import { profile } from '../data/portfolio'
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="hero__content site-shell">
    <div class="hero__eyebrow" data-reveal>
      <span class="hero__status-dot"></span>
      <span>Software engineering · security architecture · adversary thinking</span>
    </div>

    <div class="hero__title-wrap" data-reveal>
      <p class="hero__index">PE / 2026</p>
      <h1 id="hero-title" class="hero__title">
        <span>PARSA</span>
        <span class="hero__title-accent">EMAMI</span>
      </h1>
    </div>

    <div class="hero__lower">
      <div class="hero__intro" data-reveal>
        <p class="hero__headline">{profile.headline}</p>
        <p class="hero__summary">{profile.summary}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="#systems">Explore systems <span aria-hidden="true">↘</span></a>
          <a class="button" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="hero__console" aria-label="Professional profile summary" data-reveal>
        <div class="hero__console-bar">
          <span>profile.sys</span>
          <span>secure / active</span>
        </div>
        <dl>
          <div><dt>ROLE</dt><dd>Software Engineer</dd></div>
          <div><dt>FOCUS</dt><dd>Architecture + Security</dd></div>
          <div><dt>MODE</dt><dd>Build · Audit · Refactor</dd></div>
          <div><dt>DOMAIN</dt><dd>Enterprise Systems / AI / Red Team</dd></div>
          <div><dt>LOCATION</dt><dd>{profile.location}</dd></div>
        </dl>
        <div class="hero__console-footer">
          <span>01</span>
          <span class="hero__console-line"></span>
          <span>Engineering systems with explicit rules and boundaries.</span>
        </div>
      </aside>
    </div>
  </div>

  <div class="hero__marquee" aria-hidden="true">
    <div>
      <span>SOFTWARE ARCHITECTURE</span><i>◆</i><span>SECURITY ENGINEERING</span><i>◆</i><span>RED TEAM</span><i>◆</i><span>APPLIED AI</span><i>◆</i>
      <span>SOFTWARE ARCHITECTURE</span><i>◆</i><span>SECURITY ENGINEERING</span><i>◆</i><span>RED TEAM</span><i>◆</i><span>APPLIED AI</span><i>◆</i>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: 5.25rem;
    overflow: hidden;
    border-bottom: 1px solid color(shadow);

    &__grid {
      position: absolute;
      inset: 0;
      opacity: 0.28;
      background-image:
        linear-gradient(color(shadow) 1px, transparent 1px),
        linear-gradient(90deg, color(shadow) 1px, transparent 1px);
      background-size: clamp(42px, 6vw, 88px) clamp(42px, 6vw, 88px);
      mask-image: linear-gradient(to bottom, transparent 0%, black 22%, black 72%, transparent 100%);
      pointer-events: none;
    }

    &__content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - 9rem);
      padding-top: clamp(2rem, 5vw, 5rem);
      padding-bottom: clamp(3rem, 6vw, 6rem);
    }

    &__eyebrow {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      width: fit-content;
      color: color(muted);
      font: 400 clamp(0.62rem, 0.8vw, 0.76rem) / 1.3 font-family(fraktion);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    &__status-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: color(accent);
      box-shadow: 0 0 0 0.32rem color(shadow);
    }

    &__title-wrap {
      position: relative;
      margin-top: clamp(4rem, 9vw, 8.5rem);
    }

    &__index {
      position: absolute;
      top: 0.5em;
      right: 0;
      margin: 0;
      color: color(muted);
      font: 400 0.68rem / 1 font-family(fraktion);
      letter-spacing: 0.08em;
    }

    &__title {
      display: grid;
      margin: 0;
      color: color(secondary);
      font: 700 clamp(5rem, 15.5vw, 16rem) / 0.68 font-family(bigger);
      letter-spacing: -0.065em;
      text-transform: uppercase;

      span:last-child {
        justify-self: end;
      }
    }

    &__title-accent {
      color: color(accent);
      -webkit-text-stroke: 1px color(accent);
    }

    &__lower {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(330px, 0.95fr);
      gap: clamp(2rem, 8vw, 8rem);
      align-items: end;
      margin-top: auto;
      padding-top: clamp(4rem, 8vw, 7rem);
    }

    &__headline {
      max-width: 38rem;
      margin: 0;
      font: 200 clamp(1.8rem, 3.4vw, 3.4rem) / 0.98 font-family(editorial);
      letter-spacing: -0.045em;
    }

    &__summary {
      max-width: 44rem;
      margin: 1.35rem 0 0;
      color: color(muted);
      font-size: clamp(0.96rem, 1.15vw, 1.15rem);
      line-height: 1.55;
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 2rem;
    }

    &__console {
      border: 1px solid color(shadow);
      background: color(primary);
      box-shadow: 0.9rem 0.9rem 0 color(shadow);
      font-family: font-family(fraktion);
    }

    &__console-bar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.82rem 1rem;
      border-bottom: 1px solid color(shadow);
      color: color(muted);
      font-size: 0.64rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;

      span:last-child {
        color: color(accent);
      }
    }

    dl {
      margin: 0;
      padding: 1rem;
    }

    dl > div {
      display: grid;
      grid-template-columns: 5.8rem 1fr;
      gap: 1rem;
      padding: 0.62rem 0;
      border-bottom: 1px dashed color(shadow);

      &:last-child {
        border-bottom: 0;
      }
    }

    dt,
    dd {
      margin: 0;
      font-size: 0.68rem;
      line-height: 1.4;
    }

    dt {
      color: color(accent);
      letter-spacing: 0.08em;
    }

    dd {
      color: color(secondary);
    }

    &__console-footer {
      display: grid;
      grid-template-columns: auto 1fr minmax(0, 2fr);
      gap: 0.75rem;
      align-items: center;
      padding: 1rem;
      border-top: 1px solid color(shadow);
      color: color(muted);
      font-size: 0.61rem;
      line-height: 1.4;
    }

    &__console-line {
      height: 1px;
      background: color(shadow);
    }

    &__marquee {
      position: relative;
      z-index: 3;
      overflow: hidden;
      border-top: 1px solid color(shadow);
      background: color(accent);
      color: color(white);

      div {
        display: flex;
        gap: 1.1rem;
        align-items: center;
        width: max-content;
        padding: 0.75rem 0;
        animation: hero-marquee 34s linear infinite;
      }

      span,
      i {
        font: 700 0.68rem / 1 font-family(fraktion);
        letter-spacing: 0.06em;
        white-space: nowrap;
      }

      i {
        font-style: normal;
        font-size: 0.5rem;
      }
    }

    @media (max-width: 900px) {
      padding-top: 4.6rem;

      &__content {
        min-height: auto;
      }

      &__title-wrap {
        margin-top: 5rem;
      }

      &__lower {
        grid-template-columns: 1fr;
      }

      &__console {
        box-shadow: 0.5rem 0.5rem 0 color(shadow);
      }
    }

    @media (max-width: 600px) {
      &__title {
        font-size: clamp(4.4rem, 28vw, 8rem);
        line-height: 0.7;

        span:last-child {
          justify-self: start;
        }
      }

      &__index {
        display: none;
      }

      &__lower {
        padding-top: 3.5rem;
      }
    }
  }

  @keyframes hero-marquee {
    to { transform: translateX(-50%); }
  }
</style>
