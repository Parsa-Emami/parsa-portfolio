---
import { profile } from '../data/portfolio'
import IconGlyph from './IconGlyph.astro'
---

<section class="hero" id="top" aria-labelledby="hero-title" data-header-tone="dark" data-section-name="Intro">
  <canvas class="hero__field" data-hero-field aria-hidden="true"></canvas>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__shell site-shell">
    <div class="hero__top" data-hero-meta>
      <div class="hero__signal"><i></i><span>ENGINEERING SYSTEMS / ATTACK SURFACES / AI</span></div>
      <div class="hero__coordinates"><span>36.55° N</span><span>52.68° E</span><span>2026</span></div>
    </div>

    <div class="hero__title" id="hero-title">
      <div class="hero__line"><span data-hero-line data-hero-title-a>PARSA</span></div>
      <div class="hero__line hero__line--right"><span data-hero-line data-hero-title-b>EMAMI</span></div>
    </div>

    <div class="hero__orbit" data-hero-orbit aria-hidden="true">
      <svg viewBox="0 0 220 220">
        <circle cx="110" cy="110" r="94"></circle>
        <circle cx="110" cy="110" r="66"></circle>
        <path d="M110 10V210M10 110H210"></path>
        <path d="M43 43L177 177M177 43L43 177"></path>
      </svg>
      <span class="hero__orbit-mark"><IconGlyph variant="orbit" /></span>
    </div>

    <div class="hero__bottom" data-hero-meta>
      <div class="hero__intro">
        <p class="hero__role">{profile.headline}</p>
        <p class="hero__summary">{profile.summary}</p>
        <div class="hero__proof" aria-label="Portfolio highlights">
          <div><strong>03</strong><span>enterprise systems</span></div>
          <div><strong>03</strong><span>public builds</span></div>
          <div><strong>01</strong><span>adversary mindset</span></div>
        </div>
      </div>
      <div class="hero__actions">
        <a href="#systems" class="hero-link" data-magnetic data-cursor="Explore">
          <span>Selected systems</span><i>↘</i>
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hero-link hero-link--quiet" data-magnetic data-cursor="GitHub">
          <span>Public code</span><i>↗</i>
        </a>
      </div>
      <a href="#manifest" class="hero__scroll" data-nav-link data-magnetic data-cursor="Continue" aria-label="Continue to operating philosophy">
        <span class="hero__scroll-copy"><b>00 → 01</b><em>ENTER THE SYSTEM</em></span>
        <i class="hero__scroll-disc" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v13M7.5 13.5 12 18l4.5-4.5"></path></svg>
        </i>
      </a>
    </div>
  </div>

  <div class="hero__ticker" aria-hidden="true">
    <div>
      <span>SOFTWARE ARCHITECTURE</span><b>✦</b><span>SECURITY ENGINEERING</span><b>✦</b><span>RED TEAM</span><b>✦</b><span>APPLIED AI</span><b>✦</b>
      <span>SOFTWARE ARCHITECTURE</span><b>✦</b><span>SECURITY ENGINEERING</span><b>✦</b><span>RED TEAM</span><b>✦</b><span>APPLIED AI</span><b>✦</b>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: color(primary);
    border-bottom: 1px solid color(shadow);
    isolation: isolate;

    &:before,
    &:after {
      position: absolute;
      z-index: 1;
      border-radius: 50%;
      pointer-events: none;
      content: '';
    }

    &:before {
      top: 9%;
      left: 44%;
      width: min(36vw, 34rem);
      aspect-ratio: 1;
      background: radial-gradient(circle, color(accent, .12), transparent 67%);
      filter: blur(2rem);
      transform: translateX(-50%);
    }

    &:after {
      right: -12rem;
      bottom: 5%;
      width: min(34vw, 30rem);
      aspect-ratio: 1;
      border: 1px solid color(shadow, .65);
      box-shadow: inset 0 0 0 5rem color(shadow, .025), inset 0 0 0 10rem color(shadow, .018);
      opacity: .7;
    }

    &__field {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: .78;
    }

    &__shade {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(90deg, color(primary, .48), transparent 22%, transparent 78%, color(primary, .42)),
        radial-gradient(circle at 48% 42%, transparent 0, transparent 20%, color(primary, .18) 57%, color(primary, .9) 100%),
        linear-gradient(to bottom, color(primary, .05), color(primary, .62));
      pointer-events: none;
    }

    :global(.theme-contrasted) &__shade {
      background:
        linear-gradient(90deg, color(primary, .32), transparent 22%, transparent 78%, color(primary, .28)),
        radial-gradient(circle at 48% 42%, transparent 0, transparent 20%, color(primary, .08) 58%, color(primary, .8) 100%),
        linear-gradient(to bottom, color(primary, .01), color(primary, .42));
    }

    &__shell {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-height: calc(100svh - 3rem);
      padding-top: 6.7rem;
      padding-bottom: clamp(2.4rem, 4vw, 4rem);
    }

    &__top,
    &__bottom {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
      align-items: start;
    }

    &__signal,
    &__coordinates {
      display: flex;
      gap: .75rem;
      align-items: center;
      color: color(muted);
      font: 700 .58rem/1.2 font-family(fraktion);
      letter-spacing: 0.112em;
    }

    &__signal i {
      width: .45rem;
      height: .45rem;
      border-radius: 50%;
      background: color(accent);
      box-shadow: 0 0 0 .35rem color(accent, .12), 0 0 1.4rem color(accent, .7);
      animation: pulse 1.8s ease-in-out infinite;
    }

    &__coordinates { justify-content: flex-end; }

    &__title {
      align-self: center;
      width: 100%;
      margin: clamp(4rem, 9vh, 8rem) 0 clamp(3rem, 7vh, 6rem);
      font: 700 clamp(6rem, 20.5vw, 20rem)/.61 font-family(bigger);
      letter-spacing: -.015em;
      text-transform: uppercase;
    }

    &__line {
      overflow: hidden;
      padding: .08em .03em .12em;
      margin: -.06em -.03em;
      span {
        display: block;
        width: max-content;
        color: color(secondary);
        will-change: transform, filter;
      }
      &--right {
        display: flex;
        justify-content: flex-end;
        span {
          color: transparent;
          letter-spacing: .01em;
          -webkit-text-stroke: clamp(1px, .12vw, 2px) color(accent);
          // `will-change` promotes this element to its own GPU compositing
          // layer. At this font size, combining that with a stroked (not
          // filled) glyph outline triggers a Chromium tessellation bug that
          // corrupts the letterforms — so this word is deliberately excluded
          // from the GPU hint above. It's still animated by GSAP just fine.
          will-change: auto;
        }
      }
    }

    &__orbit {
      position: absolute;
      top: clamp(8.7rem, 16vh, 12rem);
      left: 50%;
      z-index: 4;
      display: grid;
      place-items: center;
      width: clamp(7rem, 12vw, 13rem);
      aspect-ratio: 1;
      transform: translateX(-50%);
      color: color(accent);
      pointer-events: none;

      svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: orbit 18s linear infinite; }
      circle, path { fill: none; stroke: currentColor; stroke-width: .7; opacity: .55; }
      circle:nth-child(2) { stroke-dasharray: 3 7; opacity: .9; }
      .hero__orbit-mark {
        display: grid;
        place-items: center;
        width: 34%;
        aspect-ratio: 1;
        color: color(accent);
        filter: drop-shadow(0 0 1rem color(accent, .28));
      }
      .hero__orbit-mark :global(.icon-glyph) { width: 100%; height: 100%; }
    }

    &__bottom {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: end;
      gap: clamp(2rem, 6vw, 6rem);
    }

    &__intro { max-width: 48rem; }
    &__role {
      margin: 0;
      font: 200 clamp(1.7rem, 3.2vw, 3.15rem)/.98 font-family(editorial);
      letter-spacing: -.045em;
    }
    &__summary {
      max-width: 44rem;
      margin: 1rem 0 0;
      color: color(muted);
      font-size: clamp(.9rem, 1vw, 1.05rem);
      line-height: 1.5;
    }

    &__proof {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      margin-top: 1.25rem;
      div {
        display: flex;
        gap: .55rem;
        align-items: baseline;
        padding: .48rem .62rem;
        border: 1px solid color(shadow);
        background: color(surface, .46);
        box-shadow: inset 0 0 0 1px color(secondary, .018);
        backdrop-filter: blur(10px);
        transition: transform .35s cubic-bezier(.22,1,.36,1), border-color .35s ease, background .35s ease;
      }
      div:hover { transform: translateY(-2px); border-color: color(accent, .48); background: color(surface-raised, .62); }
      strong { color: color(accent); font: 700 .62rem/1 font-family(fraktion); }
      span { color: color(muted); font: 700 .48rem/1 font-family(fraktion); letter-spacing: .08em; text-transform: uppercase; }
    }

    &__actions { display: grid; gap: .5rem; min-width: min(20rem, 28vw); }
    .hero-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      padding: 1rem 1.1rem;
      border: 1px solid color(accent);
      background: color(accent);
      color: color(white);
      font: 700 .65rem/1 font-family(fraktion);
      letter-spacing: 0.07em;
      text-decoration: none;
      text-transform: uppercase;
      transition: transform .45s cubic-bezier(.22,1,.36,1), box-shadow .45s cubic-bezier(.22,1,.36,1);
      will-change: transform;
      @include gloss-sweep(.4);
      &:hover { box-shadow: 0 1.4rem 2.6rem -1rem color(accent, .55); }
      &--quiet { border-color: color(shadow); background: color(primary, .78); color: color(secondary); backdrop-filter: blur(12px); &:hover { box-shadow: 0 1.4rem 2.6rem -1.2rem rgba(0,0,0,.5); } }
    }

    &__scroll {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .9rem;
      align-items: center;
      min-width: 10.8rem;
      padding: .55rem .55rem .55rem .8rem;
      border: 1px solid color(shadow);
      border-radius: 999px;
      background: color(surface, .56);
      color: color(secondary);
      text-decoration: none;
      backdrop-filter: blur(12px);
      transition: border-color .35s ease, background .35s ease, transform .45s cubic-bezier(.22,1,.36,1);
      &:hover { border-color: color(accent); background: color(surface-raised, .72); }
    }

    &__scroll-copy {
      display: grid;
      gap: .25rem;
      font-family: font-family(fraktion);
      b { color: color(accent); font-size: .47rem; letter-spacing: .12em; }
      em { color: color(muted); font-size: .49rem; font-style: normal; font-weight: 700; letter-spacing: .1em; white-space: nowrap; }
    }

    &__scroll-disc {
      position: relative;
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      overflow: hidden;
      border-radius: 50%;
      background: color(accent);
      color: color(white);
      box-shadow: 0 0 0 .28rem color(accent, .08), 0 .6rem 1.4rem -.7rem color(accent, .7);
      svg { width: 1rem; height: 1rem; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; animation: scrollArrow 1.7s cubic-bezier(.77,0,.18,1) infinite; }
    }

    &__ticker {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 4;
      overflow: hidden;
      border-top: 1px solid color(shadow);
      background: color(primary, .78);
      backdrop-filter: blur(12px);
      color: color(secondary);
      font: 700 .62rem/1 font-family(fraktion);
      letter-spacing: 0.084em;
      div { display: flex; align-items: center; gap: 1rem; width: max-content; padding: .72rem 0; animation: ticker 24s linear infinite; }
      b { color: color(accent); }
    }
  }

  @keyframes ticker { to { transform: translateX(-50%); } }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @keyframes pulse { 50% { opacity: .4; } }
  @keyframes scrollLine { 50% { transform: translateY(0); } 100% { transform: translateY(100%); } }
  @keyframes scrollArrow {
    0%, 100% { transform: translateY(-1px); opacity: .82; }
    48% { transform: translateY(4px); opacity: 1; }
    49% { transform: translateY(-5px); opacity: 0; }
    60% { opacity: 1; }
  }

  @media (max-width: 900px) {
    .hero__shell { padding-top: 5.6rem; min-height: calc(100svh - 2.6rem); }
    .hero__top { grid-template-columns: 1fr; }
    .hero__coordinates { display: none; }
    .hero__title { font-size: clamp(5.2rem, 25vw, 12rem); margin-top: 5rem; }
    .hero__orbit { top: 9.5rem; left: auto; right: 1.2rem; width: 6.5rem; transform: none; }
    .hero__bottom { grid-template-columns: 1fr; gap: 1.7rem; }
    .hero__actions { min-width: 0; grid-template-columns: 1fr 1fr; }
    .hero__scroll { justify-self: start; min-width: 10.4rem; }
  }

  @media (max-width: 560px) {
    .hero__title { font-size: clamp(4.6rem, 24vw, 8rem); line-height: .66; }
    .hero__line--right { justify-content: flex-start; }
    .hero__actions { grid-template-columns: 1fr; }
    .hero__orbit { width: 5.4rem; opacity: .65; }
    .hero__summary { font-size: .88rem; }
    .hero__scroll { display: none; }
  }
</style>
