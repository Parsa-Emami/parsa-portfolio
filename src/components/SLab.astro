---
import { labProjects, profile } from '../data/portfolio'
---

<section class="lab section" id="lab" aria-labelledby="lab-title" data-header-tone="dark" data-section-name="Lab">
  <div class="site-shell">
    <div class="section-heading lab__heading" data-reveal>
      <span class="section-number">04</span>
      <p class="section-kicker">LAB / ARCHITECTURE IN PROGRESS</p>
      <h2 id="lab-title">A specified security-platform suite. Nothing here has shipped code yet.</h2>
    </div>

    <p class="lab__intro" data-reveal>
      Ten repositories, one coherent design pass: attestation, secrets, policy enforcement, deception, forensics,
      threat scoring, privilege mapping, static analysis, network anomaly detection, and cyber-range orchestration.
      Each got a frozen architecture, explicit contracts, and a recommended build order before a single line of
      implementation — that ordering is shown below rather than hidden.
    </p>

    <div class="lab__grid">
      {labProjects.map((item) => (
        <a class="lab-card" href={item.href} target="_blank" rel="noopener noreferrer" data-reveal data-cursor="View spec" data-tilt="4">
          <div class="lab-card__top">
            <span class="lab-card__order">{item.order}</span>
            <span class="lab-card__status">SPEC · NOT IMPLEMENTED</span>
          </div>
          <h3>{item.name}</h3>
          <p class="lab-card__purpose">{item.purpose}</p>
          <div class="lab-card__stack">{item.stack.map((tech) => <span>{tech}</span>)}</div>
        </a>
      ))}
    </div>

    <a class="lab__link" href={profile.github} target="_blank" rel="noopener noreferrer" data-magnetic data-cursor="GitHub">
      SEE THE FULL SPECS ON GITHUB ↗
    </a>
  </div>
</section>

<style lang="scss">
  .lab {
    position: relative;
    background: color(surface);
  }

  .lab__heading {
    h2 { max-width: 58rem; }
  }

  .lab__intro {
    max-width: 52rem;
    margin: 2rem 0 0;
    padding-left: clamp(0rem, 8vw, 8.5rem);
    color: color(muted);
    font-size: .94rem;
    line-height: 1.62;
  }

  .lab__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
    gap: 1px;
    margin-top: clamp(3rem, 6vw, 5rem);
    background: color(shadow);
    border: 1px solid color(shadow);
  }

  .lab-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: .9rem;
    padding: clamp(1.2rem, 2vw, 1.7rem);
    background: color(surface);
    color: color(secondary);
    text-decoration: none;
    transition: background .35s ease, transform .35s ease;

    &:hover {
      background: color(surface-raised);
      transform: translateY(-2px);
    }
    &:hover .lab-card__order { color: color(accent); }

    &__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .8rem;
    }
    &__order {
      color: color(muted);
      font: 700 .78rem/1 font-family(fraktion);
      letter-spacing: 0.06em;
      transition: color .35s ease;
    }
    &__status {
      color: color(electric);
      font: 700 .5rem/1.3 font-family(fraktion);
      letter-spacing: 0.08em;
      text-align: right;
      text-transform: uppercase;
    }

    h3 {
      margin: 0;
      font: 400 1.25rem/1.15 font-family(fraktion);
      letter-spacing: -.01em;
    }

    &__purpose {
      margin: 0;
      color: color(muted);
      font-size: .82rem;
      line-height: 1.55;
    }

    &__stack {
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      span {
        padding: .3rem .42rem;
        border: 1px solid color(shadow);
        color: color(muted);
        font: 400 .48rem/1 font-family(fraktion);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
    }
  }

  .lab__link {
    display: inline-flex;
    margin-top: clamp(2rem, 4vw, 3rem);
    color: color(accent);
    font: 700 .64rem/1 font-family(fraktion);
    letter-spacing: 0.09em;
    text-decoration: none;
    border-bottom: 1px solid color(accent, .4);
    padding-bottom: .3rem;
    transition: border-color .3s ease, opacity .3s ease;
    &:hover { border-color: color(accent); opacity: .82; }
  }

  @media (max-width: 760px) {
    .lab__intro { padding-left: 0; }
  }
</style>
