---
import { systems } from '../data/portfolio'
---

<section class="systems section" id="systems" aria-labelledby="systems-title">
  <div class="site-shell">
    <div class="section-heading" data-reveal>
      <span class="section-number">02</span>
      <p class="section-kicker">Selected systems / Enterprise work</p>
      <h2 id="systems-title">Systems where business rules need to survive real production pressure.</h2>
    </div>

    <div class="systems__note" data-reveal>
      <span class="systems__note-label">ACCESS MODEL</span>
      <p>These are private or enterprise codebases. They are presented as engineering case studies rather than public repositories.</p>
    </div>

    <div class="systems__list">
      {
        systems.map((system) => (
          <article class="system-card" data-reveal>
            <div class="system-card__rail">
              <span>{system.number}</span>
              <span>PRIVATE SYSTEM</span>
            </div>

            <div class="system-card__main">
              <div class="system-card__topline">
                <p>{system.type}</p>
                <span>{system.access}</span>
              </div>
              <h3>{system.name}</h3>
              <p class="system-card__tagline">{system.tagline}</p>
              <p class="system-card__description">{system.description}</p>

              <div class="system-card__details">
                <div>
                  <p class="system-card__label">Engineering focus</p>
                  <ul>
                    {system.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </div>
                <div>
                  <p class="system-card__label">Stack / ecosystem</p>
                  <div class="system-card__stack">
                    {system.stack.map((item) => <span>{item}</span>)}
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .systems {
    background: color(secondary);
    color: color(primary);

    :global(.section-heading) {
      border-color: color(primary);
    }

    :global(.section-kicker),
    :global(.section-number) {
      color: color(accent);
    }

    &__note {
      display: grid;
      grid-template-columns: 10rem minmax(0, 38rem);
      gap: 2rem;
      justify-content: end;
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid color(primary);

      p {
        margin: 0;
        opacity: 0.72;
        font-size: 0.92rem;
      }
    }

    &__note-label {
      color: color(accent);
      font: 700 0.62rem / 1.3 font-family(fraktion);
      letter-spacing: 0.07em;
    }

    &__list {
      margin-top: clamp(4rem, 8vw, 8rem);
      border-top: 1px solid color(primary);
    }
  }

  .system-card {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    border-bottom: 1px solid color(primary);

    &__rail {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.5rem 1rem 1.5rem 0;
      border-right: 1px solid color(primary);
      color: color(accent);
      font: 400 0.63rem / 1.1 font-family(fraktion);
      letter-spacing: 0.06em;

      span:last-child {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        opacity: 0.75;
      }
    }

    &__main {
      padding: clamp(2rem, 5vw, 5rem) 0 clamp(4rem, 8vw, 7rem) clamp(1.25rem, 4vw, 4rem);
    }

    &__topline {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      color: color(primary);
      font: 400 0.66rem / 1.3 font-family(fraktion);
      letter-spacing: 0.05em;
      text-transform: uppercase;

      p { margin: 0; }
      span { opacity: 0.55; text-align: right; }
    }

    h3 {
      margin: clamp(2rem, 4vw, 4rem) 0 0;
      color: color(primary);
      font: 700 clamp(4rem, 10vw, 10rem) / 0.75 font-family(bigger);
      letter-spacing: -0.06em;
      text-transform: uppercase;
    }

    &__tagline {
      max-width: 64rem;
      margin: 2.2rem 0 0;
      font: 200 clamp(1.7rem, 3.2vw, 3.1rem) / 1.02 font-family(editorial);
      letter-spacing: -0.04em;
    }

    &__description {
      max-width: 50rem;
      margin: 1.35rem 0 0;
      opacity: 0.68;
      font-size: 1rem;
      line-height: 1.58;
    }

    &__details {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
      gap: clamp(2rem, 7vw, 7rem);
      margin-top: clamp(3rem, 6vw, 5rem);
      padding-top: 1.5rem;
      border-top: 1px solid color(primary);
    }

    &__label {
      margin: 0 0 1.35rem;
      color: color(accent);
      font: 700 0.62rem / 1.3 font-family(fraktion);
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    ul {
      display: grid;
      gap: 0.85rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    li {
      position: relative;
      max-width: 52rem;
      padding-left: 1.4rem;
      opacity: 0.82;
      font-size: 0.94rem;
      line-height: 1.5;

      &:before {
        position: absolute;
        top: 0.65em;
        left: 0;
        width: 0.45rem;
        height: 1px;
        background: color(accent);
        content: '';
      }
    }

    &__stack {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;

      span {
        padding: 0.48rem 0.62rem;
        border: 1px solid color(primary);
        border-radius: 999px;
        font: 400 0.64rem / 1 font-family(fraktion);
      }
    }

    @media (max-width: 800px) {
      grid-template-columns: 3rem minmax(0, 1fr);

      &__rail span:last-child { display: none; }
      &__details { grid-template-columns: 1fr; }
    }

    @media (max-width: 600px) {
      grid-template-columns: 1fr;

      &__rail {
        flex-direction: row;
        border-right: 0;
        border-bottom: 1px solid color(primary);
      }

      &__main { padding-left: 0; }
      &__topline { flex-direction: column; }
      &__topline span { text-align: left; }
    }
  }

  @media (max-width: 600px) {
    .systems__note { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
