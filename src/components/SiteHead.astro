---
import { profile } from '../data/portfolio'
import IconGlyph from './IconGlyph.astro'
const menu = [
  { id: 'about', text: 'Profile', number: '01' },
  { id: 'systems', text: 'Systems', number: '02' },
  { id: 'open-source', text: 'Open Source', number: '03' },
  { id: 'experience', text: 'Experience', number: '04' },
  { id: 'contact', text: 'Contact', number: '05' },
]
---

<header class="site-head" data-site-head>
  <a class="site-head__brand" href="#top" aria-label={`${profile.name} — Home`} data-nav-link data-cursor="Home" data-magnetic>
    <span class="site-head__mark"><IconGlyph variant="brand" /></span>
    <span class="site-head__name"><strong>PARSA EMAMI</strong><i>ENGINEERING / SECURITY</i></span>
  </a>

  <nav class="site-head__nav" aria-label="Primary navigation" data-section-nav>
    {menu.slice(0, 4).map((item) => <a href={`#${item.id}`} data-nav-link data-nav-target={item.id} data-magnetic><i>{item.number}</i>{item.text}</a>)}
  </nav>

  <div class="site-head__actions">
    <button type="button" class="site-head__theme" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false" data-cursor="Theme" data-magnetic>
      <span class="site-head__theme-icon" aria-hidden="true">
        <svg class="theme-symbol theme-symbol--sun" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.3"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M18.7 5.3l-1.55 1.55M6.85 17.15 5.3 18.7"></path></svg>
        <svg class="theme-symbol theme-symbol--moon" viewBox="0 0 24 24" fill="none"><path d="M20.2 15.25A8.2 8.2 0 0 1 8.75 3.8 8.25 8.25 0 1 0 20.2 15.25Z"></path></svg>
      </span>
      <span class="site-head__theme-label" data-theme-label>LIGHT</span>
    </button>
    <button type="button" class="site-head__menu-button" data-menu-toggle aria-expanded="false" aria-controls="site-menu" data-cursor="Menu" data-magnetic>
      <span>MENU</span><i></i><i></i>
    </button>
  </div>
</header>

<div class="site-menu" id="site-menu" data-site-menu aria-hidden="true">
  <div class="site-menu__backdrop" data-menu-close></div>
  <div class="site-menu__panel">
    <div class="site-menu__top">
      <span class="site-menu__identity"><IconGlyph variant="navigation" /><b>NAVIGATION</b></span>
      <button type="button" data-menu-close>CLOSE ×</button>
    </div>
    <nav aria-label="Expanded navigation">
      {menu.map((item) => (
        <a href={`#${item.id}`} data-nav-link data-menu-close>
          <span>{item.number}</span><strong>{item.text}</strong><i>↘</i>
        </a>
      ))}
    </nav>
    <div class="site-menu__social">
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </div>
</div>

<script>
  const root = document.documentElement
  const head = document.querySelector('[data-site-head]')
  const toggle = document.querySelector('[data-theme-toggle]')
  const menuToggle = document.querySelector('[data-menu-toggle]')
  const menu = document.querySelector('[data-site-menu]')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  let lastScroll = window.scrollY

  const themeLabel = document.querySelector('[data-theme-label]')

  const syncThemeControl = () => {
    const isLight = root.classList.contains('theme-contrasted')
    if (themeLabel) themeLabel.textContent = isLight ? 'DARK' : 'LIGHT'
    toggle?.setAttribute('aria-pressed', String(isLight))
    toggle?.setAttribute('aria-label', `Switch to ${isLight ? 'dark' : 'light'} color theme`)
    toggle?.setAttribute('title', `Switch to ${isLight ? 'Dark' : 'Light'} mode`)
    const themeMeta = document.querySelector('meta[name="theme-color"]')
    themeMeta?.setAttribute('content', isLight ? '#f3efe7' : '#07080a')
  }

  const applyTheme = () => {
    root.classList.toggle('theme-contrasted')
    localStorage.setItem('parsa-portfolio-theme', root.classList.contains('theme-contrasted') ? 'light' : 'dark')
    syncThemeControl()
    window.dispatchEvent(new CustomEvent('portfolio-theme-change'))
  }

  syncThemeControl()

  // Circular "wipe" reveal so switching between dark and light feels like an
  // event rather than an instant color swap. The outgoing theme's color is
  // held in a fixed overlay that irises open from the button, revealing the
  // new theme already applied underneath.
  const themeWipe = (originX: number, originY: number) => {
    const oldColor = getComputedStyle(root).getPropertyValue('--color-primary').trim() || '#07080a'
    const maxRadius = Math.hypot(
      Math.max(originX, window.innerWidth - originX),
      Math.max(originY, window.innerHeight - originY)
    ) * 1.05

    const overlay = document.createElement('div')
    overlay.className = 'theme-wipe'
    overlay.style.background = oldColor
    overlay.style.clipPath = `circle(${maxRadius}px at ${originX}px ${originY}px)`
    document.body.appendChild(overlay)

    applyTheme()

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.clipPath = `circle(0px at ${originX}px ${originY}px)`
      })
    })

    const cleanup = () => overlay.remove()
    overlay.addEventListener('transitionend', cleanup, { once: true })
    setTimeout(cleanup, 1100)
  }

  toggle?.addEventListener('click', (event) => {
    if (reduceMotion || !(toggle instanceof HTMLElement)) {
      applyTheme()
      return
    }
    const rect = toggle.getBoundingClientRect()
    const hasPointerCoords = event instanceof MouseEvent && (event.clientX || event.clientY)
    const originX = hasPointerCoords ? (event as MouseEvent).clientX : rect.left + rect.width / 2
    const originY = hasPointerCoords ? (event as MouseEvent).clientY : rect.top + rect.height / 2
    themeWipe(originX, originY)
  })

  const setMenu = (open: boolean) => {
    if (!menu || !menuToggle) return
    menu.classList.toggle('is-open', open)
    menu.setAttribute('aria-hidden', String(!open))
    menuToggle.setAttribute('aria-expanded', String(open))
    document.body.classList.toggle('menu-open', open)
    if (open) {
      requestAnimationFrame(() => menu.querySelector('button[data-menu-close]')?.focus())
    } else if (document.activeElement && menu.contains(document.activeElement)) {
      menuToggle.focus()
    }
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('is-open')) setMenu(false)
  })

  menuToggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')))
  document.querySelectorAll('[data-menu-close]').forEach((element) => element.addEventListener('click', () => setMenu(false)))

  document.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = event.currentTarget?.getAttribute('href')
      const target = href ? document.querySelector(href) : null
      if (!target) return
      event.preventDefault()
      setMenu(false)
      const lenis = (window as any).__portfolioLenis
      if (lenis) lenis.scrollTo(target, { offset: -32 })
      else target.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
  })

  const onScroll = () => {
    const current = window.scrollY
    head?.classList.toggle('is-scrolled', current > 40)
    head?.classList.toggle('is-hidden', current > lastScroll && current > 220 && !document.body.classList.contains('menu-open'))
    lastScroll = current
  }
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()

  // Adapt navigation contrast to the art direction of the section crossing
  // the viewport center. This keeps the fixed chrome readable over dark,
  // paper-light, and accent-red scenes without hard-coded scroll positions.
  const toneSections = Array.from(document.querySelectorAll('[data-header-tone]'))
  if (head && toneSections.length && 'IntersectionObserver' in window) {
    const setTone = (tone: string) => {
      head.classList.remove('is-tone-dark', 'is-tone-light', 'is-tone-accent')
      head.classList.add(`is-tone-${tone || 'dark'}`)
    }
    const toneObserver = new IntersectionObserver((entries) => {
      const active = entries.find((entry) => entry.isIntersecting)
      if (active) setTone(active.target.getAttribute('data-header-tone') || 'dark')
    }, { rootMargin: '-48% 0px -48% 0px', threshold: 0 })
    toneSections.forEach((section) => toneObserver.observe(section))
    setTone(toneSections[0]?.getAttribute('data-header-tone') || 'dark')
  }

  // Keep the primary nav honest about where the user actually is: whichever
  // section owns the vertical center of the viewport gets the active state,
  // with a soft underline that animates in rather than snapping.
  const navLinks = document.querySelectorAll('[data-nav-target]')
  if (navLinks.length) {
    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(link.getAttribute('data-nav-target') || ''))
      .filter((section) => section instanceof Element)

    const setActive = (id: string | null) => {
      navLinks.forEach((link) => {
        link.classList.toggle('is-active', !!id && link.getAttribute('data-nav-target') === id)
      })
    }

    if (sections.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
          if (visible) setActive(visible.target.id)
        },
        { rootMargin: '-42% 0px -42% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
      )
      sections.forEach((section) => observer.observe(section as Element))
    }
  }
</script>

<style lang="scss">
  .site-head {
    position: fixed;
    top: .72rem;
    left: 50%;
    z-index: 100;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: center;
    width: calc(100% - clamp(1.25rem, 3vw, 2.8rem));
    min-height: 4.5rem;
    padding: .65rem clamp(.75rem, 1.45vw, 1.35rem);
    border: 1px solid transparent;
    border-radius: 1rem;
    transform: translateX(-50%);
    color: color(secondary);
    transition: transform .5s cubic-bezier(.22,1,.36,1), background .35s ease, border-color .35s ease, box-shadow .35s ease;

    &:before {
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: linear-gradient(110deg, color(surface, .6), color(primary, .22));
      opacity: 0;
      content: '';
      transition: opacity .35s ease;
    }

    &.is-scrolled {
      border-color: color(shadow);
      background: color(glass, .76);
      box-shadow: 0 1rem 3.5rem -2rem rgba(0,0,0,.55);
      backdrop-filter: blur(22px) saturate(1.35);
    }
    &.is-scrolled:before { opacity: 1; }
    &.is-tone-light {
      color: color(primary);
      &.is-scrolled { border-color: color(primary, .16); background: color(secondary, .82); }
      .site-head__name i, .site-head__nav a { color: color(primary, .58); }
      .site-head__mark, .site-head__theme, .site-head__menu-button { border-color: color(primary, .28); }
    }
    &.is-tone-accent {
      color: color(white);
      &.is-scrolled { border-color: color(white, .24); background: color(accent, .8); }
      .site-head__name i, .site-head__nav a { color: color(white, .72); }
      .site-head__nav a i { color: color(white); }
      .site-head__mark, .site-head__theme, .site-head__menu-button { border-color: color(white, .42); }
    }
    &.is-hidden { transform: translate(-50%, -135%); }
    &__brand { display: flex; align-items: center; gap: .75rem; color: inherit; text-decoration: none; }
    &__mark {
      display: grid;
      place-items: center;
      width: 2.45rem;
      height: 2.45rem;
      border: 1px solid color(shadow);
      border-radius: .72rem;
      color: color(accent);
      background: color(surface, .55);
      box-shadow: inset 0 0 0 1px color(secondary, .025);
      font-size: 1.42rem;
      transition: transform .4s cubic-bezier(.22,1,.36,1), border-color .3s ease, background .3s ease;
    }
    &__name { display: grid; gap: .14rem; font-family: font-family(fraktion); strong { font-size: .68rem; letter-spacing: 0.056em; } i { color: color(muted); font-size: .52rem; letter-spacing: 0.112em; } }
    &__nav {
      display: flex;
      justify-content: center;
      gap: clamp(1rem, 2vw, 2.2rem);
      a {
        position: relative;
        display: flex;
        gap: .42rem;
        padding-bottom: .5rem;
        color: color(muted);
        font: 700 .58rem/1 font-family(fraktion);
        letter-spacing: 0.07em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color .3s ease;
        i { color: color(accent); font-size: .48rem; }
        &:after {
          position: absolute;
          right: 0;
          bottom: 0;
          left: 0;
          height: 1px;
          background: color(accent);
          transform: scaleX(0);
          transform-origin: left;
          transition: transform .45s cubic-bezier(.22,1,.36,1);
          content: '';
        }
        &:hover { color: color(secondary); }
        &:hover:after { transform: scaleX(1); }
        &.is-active { color: color(secondary); }
        &.is-active:after { transform: scaleX(1); }
      }
    }
    &__actions { display: flex; gap: .45rem; align-items: center; }
    &__theme, &__menu-button {
      border: 1px solid color(shadow);
      background: color(surface, .62);
      color: color(secondary);
      cursor: pointer;
      backdrop-filter: blur(12px);
    }
    &__theme {
      display: flex;
      align-items: center;
      gap: .55rem;
      min-width: 6.35rem;
      height: 2.4rem;
      padding: 0 .7rem 0 .5rem;
      border-radius: .72rem;
      transition: transform .45s cubic-bezier(.22,1,.36,1), border-color .3s ease, background .35s ease;
      &:hover { border-color: color(accent); transform: translateY(-2px); }
      &:active { transform: translateY(0) scale(.97); }
    }
    &__theme-icon {
      position: relative;
      display: grid;
      place-items: center;
      width: 1.3rem;
      height: 1.3rem;
      color: color(accent);
    }
    &__theme-label {
      font: 700 .49rem/1 font-family(fraktion);
      letter-spacing: .12em;
    }
    .theme-symbol {
      position: absolute;
      width: 1.05rem;
      height: 1.05rem;
      stroke: currentColor;
      stroke-width: 1.35;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: opacity .4s ease, transform .5s cubic-bezier(.22,1,.36,1);
    }
    .theme-symbol--sun { opacity: 1; transform: rotate(0) scale(1); }
    .theme-symbol--moon { opacity: 0; transform: rotate(45deg) scale(.65); }
    &__menu-button {
      position: relative;
      display: flex;
      align-items: center;
      gap: .8rem;
      min-height: 2.4rem;
      padding: 0 .85rem;
      font: 700 .56rem/1 font-family(fraktion);
      letter-spacing: 0.098em;
      span { margin-right: .1rem; }
      i { width: .75rem; height: 1px; background: currentColor; transition: transform .3s ease; }
    }
  }


  :global(.theme-contrasted) .site-head .theme-symbol--sun { opacity: 0; transform: rotate(-45deg) scale(.65); }
  :global(.theme-contrasted) .site-head .theme-symbol--moon { opacity: 1; transform: rotate(0) scale(1); }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 120;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s .65s;
    &.is-open { visibility: visible; pointer-events: auto; transition-delay: 0s; }
    &__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.42); opacity: 0; backdrop-filter: blur(4px); transition: opacity .5s ease; }
    &__panel {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      display: grid;
      grid-template-rows: auto 1fr auto;
      width: min(42rem, 92vw);
      padding: clamp(1.2rem, 2.5vw, 2.5rem);
      background: color(secondary);
      color: color(primary);
      transform: translateX(102%);
      transition: transform .65s cubic-bezier(.77,0,.18,1);
    }
    &.is-open &__backdrop { opacity: 1; }
    &.is-open &__panel { transform: translateX(0); }
    &__top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1rem;
      border-bottom: 1px solid color(primary, .2);
      font: 700 .57rem/1 font-family(fraktion);
      letter-spacing: 0.112em;
      button { border: 0; background: none; color: inherit; font: inherit; cursor: pointer; }
    }
    &__identity { display: inline-flex; gap: .55rem; align-items: center; }
    &__identity :global(.icon-glyph) { width: 1.2rem; height: 1.2rem; color: color(accent); }
    nav { align-self: center; display: grid; }
    nav a {
      display: grid;
      grid-template-columns: 2rem 1fr auto;
      gap: 1rem;
      align-items: center;
      padding: .65rem 0;
      border-bottom: 1px solid color(primary, .16);
      color: color(primary);
      text-decoration: none;
      span { color: color(accent); font: 700 .56rem/1 font-family(fraktion); }
      strong { font: 200 clamp(3rem, 7vw, 6rem)/.9 font-family(editorial); letter-spacing: -.055em; }
      i { font-size: 1.2rem; }
    }
    &__social { display: flex; gap: .6rem; padding-top: 1rem; border-top: 1px solid color(primary, .2); a { flex: 1; padding: .9rem; border: 1px solid color(primary, .2); color: color(primary); font: 700 .58rem/1 font-family(fraktion); text-decoration: none; text-align: center; text-transform: uppercase; } }
  }

  :global(body.menu-open) { overflow: hidden; }
  @media (max-width: 900px) { .site-head__nav { display: none; } }
  @media (max-width: 540px) {
    .site-head { top: .45rem; width: calc(100% - .8rem); border-radius: .85rem; }
    .site-head__name { display: none; }
    .site-head__menu-button span { display: none; }
    .site-head__theme { min-width: 2.4rem; width: 2.4rem; padding: 0; justify-content: center; }
    .site-head__theme-label { display: none; }
  }

  :global(.theme-wipe) {
    position: fixed;
    inset: 0;
    z-index: 995;
    pointer-events: none;
    transition: clip-path .85s cubic-bezier(.65, 0, .35, 1);
    will-change: clip-path;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.theme-wipe) { display: none; }
  }
</style>
