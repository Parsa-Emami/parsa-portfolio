---
import { profile } from '../data/portfolio'

const menu = [
  { id: 'about', text: 'About' },
  { id: 'systems', text: 'Systems' },
  { id: 'open-source', text: 'Open Source' },
  { id: 'experience', text: 'Experience' },
  { id: 'contact', text: 'Contact' },
]
---

<header class="site-head" data-site-head>
  <a class="site-head__brand" href="#top" aria-label={`${profile.name} — Home`}>
    <span class="site-head__mark" aria-hidden="true">PE</span>
    <span class="site-head__identity">
      <strong>{profile.name}</strong>
      <span>Software / Security</span>
    </span>
  </a>

  <nav class="site-head__nav" aria-label="Primary navigation">
    {
      menu.map((item) => (
        <a href={`#${item.id}`} data-nav-link>{item.text}</a>
      ))
    }
  </nav>

  <div class="site-head__actions">
    <a
      class="site-head__social"
      href={profile.github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Parsa Emami on GitHub"
    >
      GH
    </a>
    <a
      class="site-head__social"
      href={profile.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Parsa Emami on LinkedIn"
    >
      IN
    </a>
    <button class="site-head__theme" type="button" data-theme-toggle aria-label="Toggle color theme">
      <span aria-hidden="true">◐</span>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement
  const toggle = document.querySelector('[data-theme-toggle]')
  const storedTheme = localStorage.getItem('parsa-portfolio-theme')

  if (storedTheme === 'light') {
    root.classList.add('theme-contrasted')
  } else if (storedTheme === 'dark') {
    root.classList.remove('theme-contrasted')
  }

  toggle?.addEventListener('click', () => {
    root.classList.toggle('theme-contrasted')
    localStorage.setItem(
      'parsa-portfolio-theme',
      root.classList.contains('theme-contrasted') ? 'light' : 'dark'
    )
  })

  document.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = event.currentTarget?.getAttribute('href')
      const target = href ? document.querySelector(href) : null
      if (!target) return

      event.preventDefault()
      target.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
  })
</script>

<style lang="scss">
  .site-head {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;

    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: center;

    width: 100%;
    min-height: 5.25rem;
    padding: 0.9rem clamp(1rem, 2vw, 2rem);

    border-bottom: 1px solid color(shadow);
    background: color(primary);
    color: color(secondary);

    &__brand {
      @include flex(row, center, flex-start);
      gap: 0.75rem;

      color: inherit;
      text-decoration: none;
    }

    &__mark {
      @include flex(row, center, center);

      width: 2.55rem;
      height: 2.55rem;

      border: 1px solid color(secondary);
      border-radius: 50%;

      font: 700 0.82rem / 1 font-family(fraktion);
      letter-spacing: -0.08em;
    }

    &__identity {
      display: grid;
      gap: 0.12rem;

      font-family: font-family(fraktion);

      strong {
        font-size: 0.76rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      span {
        color: color(muted);
        font-size: 0.64rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    }

    &__nav {
      @include flex(row, center, center);
      gap: clamp(0.75rem, 2vw, 2rem);

      a {
        position: relative;

        color: color(muted);
        font: 400 0.69rem / 1 font-family(fraktion);
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 180ms ease;

        &:after {
          position: absolute;
          right: 0;
          bottom: -0.45rem;
          left: 0;

          height: 1px;

          background: color(accent);
          transform: scaleX(0);
          transform-origin: left;
          transition: transform 180ms ease;

          content: '';
        }

        &:hover,
        &:focus-visible {
          color: color(secondary);

          &:after {
            transform: scaleX(1);
          }
        }
      }
    }

    &__actions {
      @include flex(row, center, flex-end);
      gap: 0.45rem;
    }

    &__social,
    &__theme {
      @include flex(row, center, center);

      width: 2.25rem;
      height: 2.25rem;

      border: 1px solid color(shadow);
      border-radius: 50%;
      background: transparent;

      color: color(secondary);
      font: 700 0.62rem / 1 font-family(fraktion);
      text-decoration: none;

      cursor: pointer;
      transition:
        border-color 180ms ease,
        background 180ms ease,
        color 180ms ease;

      &:hover,
      &:focus-visible {
        border-color: color(accent);
        background: color(accent);
        color: color(white);
      }
    }

    @include mq(tablet) {
      grid-template-columns: auto 1fr auto;

      &__nav {
        justify-content: flex-end;

        a:nth-child(2),
        a:nth-child(3),
        a:nth-child(4) {
          display: none;
        }
      }
    }

    @include mq(phone) {
      min-height: 4.6rem;
      gap: 0.75rem;

      &__identity,
      &__nav {
        display: none;
      }

      &__actions {
        grid-column: 3;
      }
    }
  }
</style>
