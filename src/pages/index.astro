---
import SiteHead from '../components/SiteHead.astro'
import SiteFoot from '../components/SiteFoot.astro'
import MotionSystem from '../components/MotionSystem.astro'
import SHero from '../components/SHero.astro'
import SScrollManifesto from '../components/SScrollManifesto.astro'
import SAbout from '../components/SAbout.astro'
import SWork from '../components/SWork.astro'
import SOpenSource from '../components/SOpenSource.astro'
import SExperience from '../components/SExperience.astro'
import SCTA from '../components/SCTA.astro'
import { profile } from '../data/portfolio'
import '../styles/global.scss'

const base = import.meta.env.BASE_URL
const canonical = 'https://parsa-emami.github.io/parsa-portfolio/'
const title = 'Parsa Emami — Software Engineer · Security Architect · Red Team'
const description = 'Portfolio of Parsa Emami: software engineering, security architecture, Red Team, applied AI, enterprise systems, and open-source Laravel/JavaScript projects.'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: canonical,
  jobTitle: 'Software Engineer',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Babol',
    addressRegion: 'Mazandaran',
    addressCountry: 'IR',
  },
  sameAs: [profile.linkedin, profile.github],
  worksFor: { '@type': 'Organization', name: profile.company },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.university },
  knowsAbout: ['Software Engineering', 'Software Architecture', 'Cybersecurity', 'Red Teaming', 'Artificial Intelligence', 'Laravel', 'Software Testing'],
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}icons/favicon-48x48.png`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}icons/favicon.svg`} />
    <link rel="shortcut icon" href={`${base}icons/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="Parsa Emami" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Parsa Emami Portfolio" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href={`${base}fonts/PPEditorialNew-Regular.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={`${base}fonts/PPFraktionMono-Regular.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={`${base}fonts/Bigger-Display.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <MotionSystem />
    <SiteHead />
    <main>
      <SHero />
      <SScrollManifesto />
      <SAbout />
      <SWork />
      <SOpenSource />
      <SExperience />
      <SCTA />
    </main>
    <SiteFoot />
  </body>
</html>
